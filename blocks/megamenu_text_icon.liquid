<li  class="level 2">
  <a href="{{ block.settings.link }}">
    <span>{{ block.settings.text }}</span>
  </a>
</li>

{% schema %}
{
  "name": "Megamenu text icon",
  "tag": null,
  "settings": [
    {
        "type": "text",
        "id": "text",
        "label": "Text"
    },
    {
        "type": "image_picker",
        "id": "icon",
        "label": "Icon"
    }
  ],
  "presets": [
    {
      "name": "Megamenu text icon"
    }
  ]
}
{% endschema %}