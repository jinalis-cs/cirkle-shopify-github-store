<div class="prod-card-slide swiper-slide grid__item" data-product-id="{{ product.id }}">
  <div class="prod-card-wrap">
    {% liquid
      assign current_variant = product.selected_or_first_available_variant
      assign variant_meta_images = current_variant.metafields.custom.variant_images.value
      assign variant_featured =  current_variant.featured_image
      assign product_featured = product.featured_image

      assign primary_img = null
      if variant_featured
        assign primary_img = variant_featured
      elsif variant_meta_images.size > 0
        assign primary_img = variant_meta_images[0]
      elsif product_featured
        assign primary_img = product_featured
      endif
    %}

    <div class="product-images" data-product-images>
      <div class="prod-img-container">
        {% if primary_img or variant_meta_images.size > 0 %}
          <div class="prod-img-slider">
            <div class="swiper-wrapper">
              {% if primary_img != null %}
                <div class="image-slide swiper-slide">
                  {{ primary_img
                    | image_url: width: 1200 | image_tag: 
                    class: 'featured-image',
                    loading: 'lazy',
                    alt: primary_img.alt | escape
                  }}
                </div>
              {% endif %}

              {% if variant_meta_images.size > 0 %}
                {% liquid
                  if variant_featured
                    assign limit = 1
                  else
                    assign limit = 2
                  endif
                %}
                {% for image in variant_meta_images limit: limit %} 
                  <div class="image-slide swiper-slide">
                    {{
                      image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        alt: image.alt | escape
                    }}
                  </div>
                {% endfor %}
              {% endif %}
            </div>            
          </div>
          <script type="application/json" data-variant-metafields>
            [          
              {% for variant in product.variants %}
                {                              
                    "id": {{ variant.id }},
                    "price": {{ variant.price }},
                    "cprice": {{ variant.compare_at_price | default: 0 }},
                    {% comment %} "images": {{ variant_images | default: '' | json }} {% endcomment %}
                    "images": [
                        {% assign variant_featured_img = variant.featured_image %}
                        {% assign variant_images = variant.metafields.custom.variant_images.value %}
                        {% assign limit = 2 %}
                        {% if variant_featured_img != blank %}
                          {% assign limit = 1 %}
                          {
                            "src": "{{ variant_featured_img | image_url: width: 1200 }}",
                            "alt": "{{ variant_featured_img.alt | escape }}"
                          }{% if variant_images != blank %},{% endif %}
                        {% endif %}
                        {% if variant_images != blank %}
                          {% for image in variant_images %}
                            {% assign cnt = 0 %}
                            {% if image != variant_featured_img %}
                              {% assign cnt = cnt | plus: 1 %}
                              {
                                "src": "{{ image | image_url: width: 1200 }}",
                                "alt": "{{ image.alt | escape }}"
                              }{% if cnt == limit %}{% break %} {% else %}{% unless forloop.last %},{% endunless %} {% endif %}                              
                            {% endif %}
                          {% endfor %}
                        {% endif %}
                      ]
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ]
          </script>
        {% else %}
          {{ 'product-apparel-1' | placeholder_svg_tag }}
        {% endif %}
      </div>
      <div class="swiper-pagination cstm-swiper-pagination"></div>
    </div>

    {% comment %} {% liquid
      assign current_variant = product.selected_or_first_available_variant
      assign variant_img_available = false
      assign variant_images = ''
      for variant in product.variants
        if variant.metafields.custom.variant_images != blank
          assign variant_meta = variant
          assign variant_images = variant_meta.metafields.custom.variant_images.value
          assign variant_img_available = true
          break
        endif
      endfor
    %}

    <div class="product-images">
      <div class="prod-img-slider-wrap mobile">
        {% if variant_img_available %}
          <div class="prod-img-slider">
            <div class="swiper-wrapper">
              {% assign limit = 2 %}
              {% if current_variant.featured_image != blank %}
                {% assign limit = 1 %}
                <div class="image-slide swiper-slide">
                  {{ current_variant.featured_image | image_url: width: 1200 | image_tag: class: 'featured-image' }}
                </div>
              {% endif %}
              {% for image in variant_images limit: limit %}
                <div class="image-slide swiper-slide">
                  {{
                    image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                      widths: '165, 360, 535, 750, 940, 1200',
                      alt: image.alt | escape
                  }}
                </div>
              {% endfor %}
            </div>
            <div class="swiper-pagination"></div>
          </div>
        {% elsif current_variant.featured_image != blank %}
          <div>{{ current_variant.featured_image | image_url: width: 1200 | image_tag: class: 'featured-image' }}</div>
        {% elsif product.featured_image != blank %}
          {{ product.featured_image | image_url: width: 1200 | image_tag: class: 'featured-image' }}
        {% else %}
          {{ 'product-apparel-1' | placeholder_svg_tag }}
        {% endif %}
      </div>
      <div class="prod-featured-img-wrap desktop">
        {% assign current_variant_meta_img = current_variant.metafields.custom.variant_images.value %}
        
        {% if current_variant.featured_image != blank %}
          {{ current_variant.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'featured-image' }}
        {% elsif current_variant_meta_img != blank %}
          {% assign first_image = current_variant_meta_img | first %}
          {{ first_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'featured-image' }}        
        {% elsif product.featured_image != blank %}
          {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'featured-image' }}
        {% else %}
          {{ 'product-apparel-1' | placeholder_svg_tag }}
        {% endif %}
        {% comment %} {{
          first_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '165, 360, 535, 750, 940, 1200',
            class: 'featured-image'
            alt: first_image.alt | escape
        }} {% endcomment %}
      </div>

      <script type="application/json" data-variant-metafields>
        [          
          {% for variant in product.variants %}
            {                              
                "id": {{ variant.id }},
                "price": {{ variant.price }},
                "cprice": {{ variant.compare_at_price | default: 0 }},
                {% comment %} "images": {{ variant_images | default: '' | json }} {% endcomment %}
                "images": [
                    {% assign variant_featured_img = variant.featured_image %}
                    {% assign variant_images = variant.metafields.custom.variant_images.value %}
                    {% assign limit = 2 %}
                    {% if variant_featured_img != blank %}
                      {% assign limit = 1 %}
                      {
                        "src": "{{ variant_featured_img | image_url: width: 1200 }}",
                        "alt": "{{ variant_featured_img.alt | escape }}"
                      }{% if variant_images != blank %},{% endif %}
                    {% endif %}
                    {% if variant_images != blank %}
                      {% for image in variant_images limit: limit %}
                        {
                          "src": "{{ image | image_url: width: 1200 }}",
                          "alt": "{{ image.alt | escape }}"
                        }{% unless forloop.last %},{% endunless %}
                      {% endfor %}
                    {% endif %}
                  ]
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      </script>
    </div> {% endcomment %}

    <div class="prod-details">
      <div class="prod-title-price">
        <div class="prod-title"><a href="{{ product.url }}">{{ product.title }}</a></div>
        <div class="prod-price">
          {% if product.variants.size > 1 %}
            {{ product.variants[0].price | money }}
          {% else %}
            {{ product.price | money }}
          {% endif %}
        </div>
      </div>
      <div class="prod-addtocart">
        <product-form data-section-id="{{ section.id }}">
          {%- form 'product',
            product,
            id: product_form_id,
            class: 'form',
            novalidate: 'novalidate',
            data-type: 'add-to-cart-form'
          -%}
            <input
              type="hidden"
              name="id"
              value="{{ product.selected_or_first_available_variant.id }}"
              class="product-variant-id"
              {% if product.selected_or_first_available_variant.available == false %}
                disabled
              {% endif %}
            >
            <button
              id="{{ product_form_id }}-submit"
              type="submit"
              name="add"
              class="quick-add__submit button button--full-width button--secondary{% if horizontal_quick_add %} card--horizontal__quick-add{% endif %}"
              aria-haspopup="dialog"
              aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product.id }}"
              aria-live="polite"
              data-sold-out-message="true"
              {% if product.selected_or_first_available_variant.available == false %}
                disabled
              {% endif %}
            >
              <span>
                {%- if product.selected_or_first_available_variant.available -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </span>
              <span class="sold-out-message hidden">
                {{ 'products.product.sold_out' | t }}
              </span>
              {%- if horizontal_quick_add -%}
                <span class="icon-wrap">
                  {{- 'icon-plus.svg' | inline_asset_content -}}
                </span>
              {%- endif -%}
              {%- render 'loading-spinner' -%}
            </button>
          {%- endform -%}
        </product-form>
      </div>      
      {% assign has_swatches = false %}
      {% for option in product.options_with_values %}
        {% assign count = option.values | map: 'swatch' | compact | size %}
        {% if count > 0 %}
          {% assign has_swatches = true %}
          {% break %}
        {% endif %}
      {% endfor %}
      {% if has_swatches %}
        <variant-swatchs class="prod-variants js product-form__input product-form__input--swatch">
          {%- for option in product.options_with_values -%}
            {% assign swatch_count1 = option.values | map: 'swatch' | compact | size %}
            {% if swatch_count1 == 0 %}
              {% continue %}
            {% endif %}
            {%- for value in option.values -%}
              {% comment %} <div class="variant-swatch"> {% endcomment %}
                {%- liquid
                  assign swatch = value.swatch
                  assign swatch_value = null
                  assign shape = 'circle'
                  if swatch.image 
                    assign image_url = swatch.image | image_url: width: 50
                    assign swatch_value = 'url(' | append: image_url | append: ')'
                  elsif swatch.color
                    assign swatch_value = 'rgb(' | append: swatch.color.rgb | append: ')'
                  endif
                %}
                <input
                  type="radio"
                  id="{{ product.id }}-{{ option.position }}-{{ forloop.index0 -}}"
                  name="{{ option.name }}-{{ product.id }}-swatch"
                  value="{{ value }}"
                  class="swatch-input__input"
                  {% if forloop.first %}
                    checked
                  {% endif %}
                  {% if disabled %}
                    disabled
                  {% endif %}
                  data-variant-id="{{ value.variant.id }}"
                >
                <label class="swatch-input__label" for="{{ product.id}}-{{ option.position }}-{{ forloop.index0 -}}">
                  <span
                    {% if swatch_value %}
                      class="swatch{% if shape == 'square' %} swatch--square{% endif %}"
                      style="background: {{ swatch_value }};"
                    {% else %}
                      class="swatch swatch--unavailable{% if shape == 'square' %} swatch--square{% endif %}"
                    {% endif %}
                    style="display: block !important"
                  ></span>
                </label>
              {% comment %} </div> {% endcomment %}
            {%- endfor -%}
          {%- endfor -%}
        </variant-swatchs>
      {% endif %}
    </div>
  </div>
</div>