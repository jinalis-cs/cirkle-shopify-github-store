{% if block.settings.product_list != blank %}
  <div class="bundle-prod-wrap">
    {% if block.settings.addon_prod_heading != blank %}
      <h2 class="h4 accordion__title">{{ block.settings.addon_prod_heading }}</h2>
    {% endif %}
    {% assign product_list = block.settings.product_list %}
    <div class="bundle-prod-list">
      {% for bundle_prod in product_list %}
        {% if bundle_prod != blank %}
          {% assign prod_in_cart = false %}
          {% for item in cart.items %}
            {% if item.product_id == bundle_prod.id %}
               {% assign cart_lineitem_index = forloop.index %}
               {% assign prod_in_cart = true %}
               {% assign item_variant = item.variant %}
             {% endif %}
           {% endfor %}
          <div class="bundle-prod-item">            
            <div class="bundle-prod-img"><img src="{{ bundle_prod.featured_image | img_url: 'small' }}"></div>
            <div class="bundle-prod-addtocart">      
              <input 
                type="checkbox" 
                class="chk-bundle-prod" 
                id="chk-bundle-prod-{{ forloop.index }}" 
                value="{{ bundle_prod.selected_or_first_available_variant.id }}"
                {% if prod_in_cart %}
                  data-cartitem-index="{{ cart_lineitem_index }}"
                  checked
                {% endif %}
              >
              {% comment %}<input type="hidden" name="items[{{ forloop.index }}][quantity]" class="bundle_prod_qty" value="1" form="{{ product_form_id }}" disabled>{% endcomment %}
              <input type="hidden" name="items[{{ forloop.index }}][id]" class="bundle_prod_variants" value="{{ bundle_prod.selected_or_first_available_variant.id }}" form="{{ product_form_id }}" disabled>
              <input type="hidden" name="items[{{ forloop.index }}][properties[bundle_product]]" class="bundle_prod_properties random_number" value="{{ randomNumber }}" form="{{ product_form_id }}" disabled>
            </div> 
            <div class="bundle-prod-info">
              <div class="bundle-prod-title"><a href="{{ bundle_prod.url }}">{{ bundle_prod.title }}</a></div>
              <div class="bundle-prod-qty-wrap">
                <quantity-input class="quantity" data-url="{{ product.url }}" data-section="{{ section.id }}">
                  <button class="quantity__button" name="minus" type="button">
                    <span class="visually-hidden">
                      {{- 'products.product.quantity.decrease' | t: product: bundle_prod.title | escape -}}
                    </span>
                    <span class="svg-wrapper">
                      {{- 'icon-minus.svg' | inline_asset_content -}}
                    </span>
                  </button>
                  <input
                    class="quantity__input bundle_prod_qty"
                    type="number"
                    name="items[{{ forloop.index }}][quantity]"
                    id="Quantity-{{ section.id }}"
                    data-min="{{ bundle_prod.selected_or_first_available_variant.quantity_rule.min }}"
                    min="{{ bundle_prod.selected_or_first_available_variant.quantity_rule.min }}"
                    {% if bundle_prod.selected_or_first_available_variant.quantity_rule.max != null %}
                      data-max="{{ bundle_prod.selected_or_first_available_variant.quantity_rule.max }}"
                      max="{{ bundle_prod.selected_or_first_available_variant.quantity_rule.max }}"
                    {% endif %}
                    step="{{ bundle_prod.selected_or_first_available_variant.quantity_rule.increment }}"
                    value="{{ bundle_prod.selected_or_first_available_variant.quantity_rule.min }}"
                    form="{{ product_form_id }}"
                    disabled
                  >
                  <button class="quantity__button" name="plus" type="button">
                    <span class="visually-hidden">
                      {{- 'products.product.quantity.increase' | t: product: bundle_prod.title | escape -}}
                    </span>
                    <span class="svg-wrapper">
                      {{- 'icon-plus.svg' | inline_asset_content -}}
                    </span>
                  </button>
                </quantity-input>
              </div>   
            </div>
            <div class="bundle-prod-price-wrap">
              {% if bundle_prod.compare_at_price > bundle_prod.price %}
                <s class="bundle-prod-cprice">{{ bundle_prod.compare_at_price | money }}</s>
              {% endif %}
              <span class="bundle-prod-price">{{ bundle_prod.price | money }}</span>
            </div>
          </div>  
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <script>
    let chk_bundle_prods = document.querySelectorAll('.chk-bundle-prod');
    chk_bundle_prods.forEach((chkBundleProd) => {
      chkBundleProd.addEventListener('click',(e) => {         
        chkBundleProd.closest('.bundle-prod-item').querySelector('.bundle_prod_properties').removeAttribute('disabled');
        chkBundleProd.closest('.bundle-prod-item').querySelector('.bundle_prod_variants').removeAttribute('disabled');
        chkBundleProd.closest('.bundle-prod-item').querySelector('.bundle_prod_qty').removeAttribute('disabled');
        const main_prod_properties = chkBundleProd.closest('.product__info-wrapper').querySelector('.main_prod_bundle_properties');
        const count_checked_bundle = document.querySelectorAll('.chk-bundle-prod:checked');
        (main_prod_properties.hasAttribute('disabled')) ? main_prod_properties.removeAttribute('disabled') : '';
        if(count_checked_bundle.length == 0) {
          main_prod_properties.setAttribute('disabled','');
          document.querySelectorAll('.bundle-prod-item').forEach(function(bundle_prod){
            bundle_prod.querySelector('.bundle_prod_properties').setAttribute('disabled','');
            bundle_prod.querySelector('.bundle_prod_variants').setAttribute('disabled','');
            bundle_prod.querySelector('.bundle_prod_qty').setAttribute('disabled','');
          });
        }
      });
    });
  </script>
{% endif %}