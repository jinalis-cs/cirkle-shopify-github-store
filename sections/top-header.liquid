<div class="top-header">
  <div class="page-width">
    <a href="javascript:void()" class="category-link">Category</a>
    <div id="CategoryPopup" class="category-popup">
      <div class="category_popup_content"  style="display:flex;">{% content_for 'blocks' %}</div>
    </div>
    <div id="BrandPopup" class="brand-popup">
      <div class="category_popup_content"  style="display:flex;">
        {% assign brand_list = section.settings.metaobject %}
        {% for brand in brand_list %}
          {{ brand.brand_name }}
          {{ collections[brand.collection].url }}
          <img src="{{ brand.image | image_url: width: 100  }}">
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Top header",
  "tag": "section",
  "class": "section top-header-section",
  "disabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "metaobject_list",
      "id": "metaobject",
      "metaobject_type": "brand_list",
      "label": "Metaobject"
    },    
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "category",
    }
  ],
  "presets": [
    {
      "name": "Top header",
      "category": "Custom Section"
    }
  ]
}
{% endschema %}