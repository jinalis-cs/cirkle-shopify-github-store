{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  {% comment %} <form id="custom-contact-form">
    <input type="text" name="name" placeholder="Name" required>  
    <input type="email" name="email" placeholder="Email" required>  
    <input type="tel" name="phone" placeholder="Phone">  
    <textarea name="message" placeholder="Message"></textarea>
    <button type="submit">Submit</button>

    <p class="form-success" style="display:none; color:green;">
      Form submitted successfully!
    </p>

    <p class="form-error" style="display:none; color:red;">
      Something went wrong.
    </p>
  </form> {% endcomment %}
  <div class="card">
  <div class="label-tag"><span class="brand-dot"></span>Vendor Portal</div>
  <h1>Register as a Vendor</h1>
  <p class="subtitle">Fill in your details and we'll get back to you shortly.</p>
  <hr class="divider"/>
 
  <form id="vendorForm" novalidate>
 
    <p class="section-title">Personal Details</p>
    <div class="grid-2">
      <div class="field">
        <label for="vendorName">Full Name <span class="req">*</span></label>
        <input type="text" id="vendorName" name="vendorName" placeholder="Jane Doe" required />
      </div>
      <div class="field">
        <label for="phone">Phone Number <span class="req">*</span></label>
        <input type="tel" id="phone" name="phone" placeholder="+91 98765 43210" required />
      </div>
    </div>
 
    <div class="field">
      <label for="email">Email Address <span class="req">*</span></label>
      <input type="email" id="email" name="email" placeholder="jane@example.com" required />
    </div>
 
    <hr class="divider"/>
    <p class="section-title">Business Details</p>
 
    <div class="grid-2">
      <div class="field">
        <label for="businessName">Business Name <span class="req">*</span></label>
        <input type="text" id="businessName" name="businessName" placeholder="Acme Supplies Co." required />
      </div>
      <div class="field">
        <label for="category">Category <span class="req">*</span></label>
        <select id="category" name="category" required>
          <option value="" disabled selected>Select category</option>
          <option>Electronics</option>
          <option>Clothing & Apparel</option>
          <option>Food & Beverages</option>
          <option>Home & Garden</option>
          <option>Beauty & Health</option>
          <option>Sports & Outdoors</option>
          <option>Toys & Games</option>
          <option>Other</option>
        </select>
      </div>
    </div>
 
    <div class="field">
      <label for="address">Business Address</label>
      <input type="text" id="address" name="address" placeholder="123 Market St, Ahmedabad, Gujarat" />
    </div>
 
    <div class="field">
      <label for="message">Additional Notes</label>
      <textarea id="message" name="message" placeholder="Tell us about your products or any questions..."></textarea>
    </div>
 
    <button type="submit" class="btn" id="submitBtn">
      <span class="btn-inner">
        <span id="btnText">Submit Registration</span>
        <span class="spinner" id="spinner"></span>
      </span>
    </button>
 
    <div class="toast" id="toast"></div>
  </form>
</div>
</div>

<script>
  // ✅ PASTE YOUR GOOGLE APPS SCRIPT WEB APP URL HERE
  const SHEET_URL = "https://script.google.com/macros/s/AKfycbwhlwMLCMfuCTtZPqs9Vi1LWNxJHzeTYiQMD9iq8Y1O4jUGtDFINuIEKRr8i-Jtx2Mt/exec";
 
  const form = document.getElementById("vendorForm");
  const btn  = document.getElementById("submitBtn");
  const spinner = document.getElementById("spinner");
  const btnText = document.getElementById("btnText");
  const toast = document.getElementById("toast");
 
  function showToast(type, msg) {
    toast.className = "toast " + type;
    toast.textContent = type === "success" ? "✅ " + msg : "❌ " + msg;
  }
 
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    toast.className = "toast"; // hide
 
    // Basic validation
    const required = form.querySelectorAll("[required]");
    let valid = true;
    required.forEach(el => {
      el.style.borderColor = "";
      if (!el.value.trim()) {
        el.style.borderColor = "#c8522a";
        valid = false;
      }
    });
    if (!valid) { showToast("error", "Please fill in all required fields."); return; }
 
    // Collect form data
    const payload = {
      vendorName:   document.getElementById("vendorName").value.trim(),
      businessName: document.getElementById("businessName").value.trim(),
      email:        document.getElementById("email").value.trim(),
      phone:        document.getElementById("phone").value.trim(),
      category:     document.getElementById("category").value,
      address:      document.getElementById("address").value.trim(),
      message:      document.getElementById("message").value.trim(),
    };
 
    // Loading state
    btn.disabled = true;
    btnText.textContent = "Submitting…";
    spinner.style.display = "block";
 
    try {
      // Google Apps Script requires no-cors for cross-origin POST
      await fetch(SHEET_URL, {
        method: "POST",
        mode: "no-cors",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
 
      // no-cors means we can't read the response, but if no error thrown = success
      showToast("success", "Your registration was submitted successfully!");
      form.reset();
 
    } catch (err) {
      showToast("error", "Submission failed. Please try again.");
      console.error(err);
    } finally {
      btn.disabled = false;
      btnText.textContent = "Submit Registration";
      spinner.style.display = "none";
    }
  });
</script>

