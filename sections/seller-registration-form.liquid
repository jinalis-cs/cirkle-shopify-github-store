
{% comment %} https://claude.ai/share/7525d52b-2425-4fad-9c25-1a3bf57de7b6 {% endcomment %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap">

<div
  class="msp"
  id="msp-{{ section.id }}"
  style="--ac: {{ section.settings.accent }};"
  data-endpoint="{{ section.settings.endpoint | escape }}"
  data-maxmb="{{ section.settings.max_file_mb }}"
  data-cats="{{ section.settings.categories | escape }}"
  data-success-title="{{ section.settings.success_title | escape }}"
  data-success-text="{{ section.settings.success_text | escape }}"
>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <symbol id="i-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M7.5 12.5l3.2 3.2 5.8-6.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="i-up" viewBox="0 0 24 24"><path d="M12 17V7m0 0l-4 4m4-4l4 4M6 20h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="i-plus" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 7.5v9M7.5 12h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></symbol>
      <symbol id="i-wh" viewBox="0 0 24 24"><path d="M3 20V9l9-5 9 5v11M7 20v-6h10v6M7 17h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/></symbol>
      <symbol id="i-doc" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 16h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/></symbol>
      <symbol id="i-bag" viewBox="0 0 24 24"><path d="M5 8h14l-1 12H6zM9 8V6a3 3 0 016 0v2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/></symbol>
      <symbol id="i-tag" viewBox="0 0 24 24"><path d="M3 12V4h8l10 10-8 8zM7.5 8.5h.01" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></symbol>
      <symbol id="i-x" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
      <symbol id="i-chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    </defs>
  </svg>

  {%- if section.settings.notice != blank -%}
    <div class="msp-notice">{{ section.settings.notice }}</div>
  {%- endif -%}

  <div class="msp-wrap">

    <!-- ============ TABS ============ -->
    <div class="msp-tabs card" role="tablist">
      <button type="button" class="tab on" data-tab="0" role="tab"><svg><use href="#i-doc"/></svg>Seller Information</button>
      <button type="button" class="tab" data-tab="1" role="tab"><svg><use href="#i-wh"/></svg>Warehouse Details</button>
      <button type="button" class="tab" data-tab="2" role="tab"><svg><use href="#i-bag"/></svg>Brand Details</button>
    </div>

    <!-- ============ PANEL 1 : SELLER INFORMATION ============ -->
    <div class="panel" data-panel="0">
      <div class="card">
        <div class="sec" data-sec="gst">
          <div class="sec-l"><svg class="ck"><use href="#i-check"/></svg><div><h3>GSTIN Number</h3><p>The GSTIN number you will be using for your business with Myntra.</p></div></div>
          <div class="sec-r">
            <div><button type="button" class="btn" data-act="open-gst">+ Add</button></div>
            <div id="gst-list" class="chips"></div>
            <div class="msg-err" id="gst-err" hidden>Add at least one GSTIN to continue.</div>
          </div>
        </div>

        <div class="sec" data-sec="primary" id="sec-primary">
          <div class="sec-l"><svg class="ck"><use href="#i-check"/></svg><div><h3>Primary Contact</h3><p>Primary contact for all seller registration related communications.</p></div></div>
          <div class="sec-r">
            <div class="grid1">
              <div class="f"><label class="req">Primary contact's name</label><input type="text" name="pname" data-rule="name" placeholder="Enter full name" autocomplete="name"><div class="err"></div></div>
            </div>
            <div class="grid2">
              <div class="f"><label class="req">Primary contact's phone number</label><input type="text" name="pphone" data-rule="phone" inputmode="numeric" maxlength="10" placeholder="Enter 10 digit phone number" autocomplete="tel-national"><div class="err"></div></div>
              <div class="f"><label class="req">Primary contact's email ID</label><input type="text" name="pemail" data-rule="email" placeholder="Enter email ID" autocomplete="email"><div class="err"></div></div>
            </div>
          </div>
        </div>

        <div class="sec" data-sec="owner" id="sec-owner">
          <div class="sec-l"><svg class="ck"><use href="#i-check"/></svg><div><h3>Business Owner Details</h3><p>Name and information of the business owner.</p></div></div>
          <div class="sec-r">
            <label class="chk"><input type="checkbox" id="same-owner"> Business owner's contact is same as primary contact.</label>
            <div class="grid1">
              <div class="f"><label class="req">Owner's name</label><input type="text" name="oname" data-rule="name" placeholder="Enter full name"><div class="err"></div></div>
            </div>
            <div class="grid2">
              <div class="f"><label class="req">Owner's phone number</label><input type="text" name="ophone" data-rule="phone" inputmode="numeric" maxlength="10" placeholder="Enter 10 digit phone number"><div class="err"></div></div>
              <div class="f"><label class="req">Owner's email ID</label><input type="text" name="oemail" data-rule="email" placeholder="Enter email ID"><div class="err"></div></div>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="sec" data-sec="tds">
          <div class="sec-l"><svg class="ck"><use href="#i-check"/></svg><div><h3>TDS Benefit Details</h3><p>Select if you want to avail TDS benefits. If yes, provide your TAN number.</p></div></div>
          <div class="sec-r">
            <div class="grid2 opts">
              <label class="opt"><input type="radio" name="tds" value="yes"> Yes, I want to claim TDS benefits</label>
              <label class="opt"><input type="radio" name="tds" value="no"> No, I do not want to claim TDS benefits</label>
            </div>
            <div class="msg-err" id="tds-err" hidden>Select an option.</div>
            <div class="grid1" id="tan-wrap" hidden>
              <div class="f"><label class="req">TAN number</label><input type="text" name="tan" data-rule="tan" data-upper="1" maxlength="10" placeholder="Enter TAN number (e.g. ABCD12345E)"><div class="err"></div></div>
            </div>
          </div>
        </div>

        <div class="sec" data-sec="sign">
          <div class="sec-l"><svg class="ck"><use href="#i-check"/></svg><div><h3>Owner's Signature</h3><p>Upload an Image / PDF of owner's signature.</p></div></div>
          <div class="sec-r">
            <div class="drop" data-key="signature" tabindex="0">
              <input type="file" hidden accept="image/png,image/jpeg,application/pdf">
              <div class="drop-empty"><span class="up"><svg><use href="#i-up"/></svg></span><p>Drag &amp; Drop / Click To Upload Signature PDF <b>*</b></p></div>
              <div class="drop-file"><svg class="fi"><use href="#i-doc"/></svg><span class="drop-name"></span><button type="button" class="link" data-remove>Remove</button></div>
              <div class="drop-err"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="sec" data-sec="bank" id="sec-bank">
          <div class="sec-l"><svg class="ck"><use href="#i-check"/></svg><div><h3>Bank Account Details</h3><p>Upload a current account's cheque Image and check the details fetched from it.</p><p class="note">Add only current account not savings account. Please verify bank details carefully.</p></div></div>
          <div class="sec-r">
            <div class="drop" data-key="cheque" tabindex="0">
              <input type="file" hidden accept="image/png,image/jpeg,application/pdf">
              <div class="drop-empty"><span class="up"><svg><use href="#i-up"/></svg></span><p>Drag &amp; Drop / Click To Upload Cheque PDF <b>*</b></p></div>
              <div class="drop-file"><svg class="fi"><use href="#i-doc"/></svg><span class="drop-name"></span><button type="button" class="link" data-remove>Remove</button></div>
              <div class="drop-err"></div>
            </div>
            <div class="grid1">
              <div class="f"><label class="req">Bank Name</label><input type="text" name="bank" data-rule="text" placeholder="Enter bank name"><div class="err"></div></div>
            </div>
            <div class="grid2">
              <div class="f"><label class="req">Account Type</label><input type="text" name="acctype" value="Current Account" readonly class="ro"></div>
              <div class="f"><label class="req">IFSC Code</label><input type="text" name="ifsc" data-rule="ifsc" data-upper="1" maxlength="11" placeholder="Enter IFSC code"><div class="err"></div></div>
            </div>
            <div class="grid2">
              <div class="f"><label class="req">Account Number</label><input type="text" name="acc" data-rule="acc" inputmode="numeric" maxlength="18" placeholder="Enter account number"><div class="err"></div></div>
              <div class="f"><label class="req">Account Holder's Name</label><input type="text" name="holder" data-rule="name" placeholder="Enter full name"><div class="err"></div></div>
            </div>
          </div>
        </div>

        <div class="sec" data-sec="bverify">
          <div class="sec-l"><svg class="ck"><use href="#i-check"/></svg><div><h3>Bank Account Verification</h3><p>A small amount will be credited to your account. Enter the exact amount.</p></div></div>
          <div class="sec-r">
            <div><button type="button" class="btn" id="bank-verify" disabled>Send Amount To Verify Account</button></div>
            <div class="ok-note" id="bank-note" hidden>Verification request sent. We will credit a small amount to this account and confirm it.</div>
            <div class="msg-err" id="bank-err" hidden>Click "Send Amount To Verify Account" to continue.</div>
          </div>
        </div>
      </div>

      <div class="card nav"><span></span><button type="button" class="btn" data-act="next">Next <svg class="ar"><use href="#i-chev"/></svg></button></div>
    </div>

    <!-- ============ PANEL 2 : WAREHOUSE DETAILS ============ -->
    <div class="panel" data-panel="1" hidden>
      <div id="wh-list" class="items"></div>
      <button type="button" class="card addcard" data-act="open-wh"><svg><use href="#i-plus"/></svg><span>Click to Add New Warehouse</span></button>
      <div class="msg-err pad" id="wh-err" hidden>Add at least one warehouse to continue.</div>
      <div class="card nav"><button type="button" class="btn ghost" data-act="prev"><svg class="ar l"><use href="#i-chev"/></svg> Previous</button><button type="button" class="btn" data-act="next">Next <svg class="ar"><use href="#i-chev"/></svg></button></div>
    </div>

    <!-- ============ PANEL 3 : BRAND DETAILS ============ -->
    <div class="panel" data-panel="2" hidden>
      <div id="br-list" class="items"></div>
      <button type="button" class="card addcard" data-act="open-br"><svg><use href="#i-plus"/></svg><span>Click to Add New Brand</span></button>
      <div class="msg-err pad" id="br-err" hidden>Add at least one brand to submit.</div>
      <div class="card nav"><button type="button" class="btn ghost" data-act="prev"><svg class="ar l"><use href="#i-chev"/></svg> Previous</button><button type="button" class="btn" id="submit-btn" data-act="submit" disabled>Submit <svg class="ar"><use href="#i-chev"/></svg></button></div>
    </div>

    <!-- ============ SUCCESS ============ -->
    <div class="card done" id="done" hidden>
      <svg class="big"><use href="#i-check"/></svg>
      <h2 id="done-title"></h2>
      <p id="done-text"></p>
      <p class="sid">Reference ID: <b id="done-id"></b></p>
    </div>
  </div>

  <!-- ============ MODAL : ADD GSTIN ============ -->
  <div class="modal" data-modal="gst" hidden>
    <div class="m-card small" role="dialog" aria-modal="true">
      <div class="m-h"><svg><use href="#i-doc"/></svg><h2>Add GSTIN</h2><button type="button" class="m-x" data-close aria-label="Close"><svg><use href="#i-x"/></svg></button></div>
      <div class="m-b">
        <div class="f"><label class="req">GSTIN Number</label>
          <div class="inline"><input type="text" name="g_gstin" data-rule="gstin" data-upper="1" maxlength="15" placeholder="Enter GSTIN number"><button type="button" class="btn" data-act="verify-gst" disabled>Verify</button></div>
          <div class="err"></div></div>
        <div class="gbox" id="g-box"><p>Enter GST number to view details</p></div>
      </div>
      <div class="m-f"><button type="button" class="btn ghost" data-close>Cancel</button><button type="button" class="btn" data-act="save-gst" disabled>Add GSTIN</button></div>
    </div>
  </div>

  <!-- ============ MODAL : WAREHOUSE ============ -->
  <div class="modal" data-modal="wh" hidden>
    <div class="m-card" role="dialog" aria-modal="true">
      <div class="m-h"><svg><use href="#i-wh"/></svg><h2 id="wh-title">Warehouse 1 Details :</h2><button type="button" class="m-x" data-close aria-label="Close"><svg><use href="#i-x"/></svg></button></div>
      <div class="m-b">
        <div class="sec">
          <div class="sec-l"><svg class="ck"><use href="#i-check"/></svg><div><h3>Warehouse Address</h3><p>Please enter accurate GSTIN number and check the address details.</p></div></div>
          <div class="sec-r">
            <div class="f"><label class="req">GSTIN Number</label>
              <div class="inline"><input type="text" name="w_gstin" data-rule="gstin" data-upper="1" maxlength="15" list="wh-gst-list" placeholder="Enter GSTIN number"><button type="button" class="btn" data-act="verify-wh" disabled>Verify</button></div>
              <datalist id="wh-gst-list"></datalist><div class="err"></div></div>
            <div class="gbox" id="w-box">
              <svg class="illu" viewBox="0 0 160 110"><ellipse cx="80" cy="96" rx="58" ry="9" fill="#eef0f5"/><rect x="30" y="14" width="46" height="62" rx="3" fill="#cfd3de"/><path d="M38 28h30M38 38h30M38 48h30M38 58h22" stroke="#fff" stroke-width="3" stroke-linecap="round"/><circle cx="104" cy="30" r="9" fill="#2a2150"/><path d="M92 44h24l6 22-8 22h-8l-2-14-2 14h-8z" fill="#5333d6"/></svg>
              <p>Enter GST number to view address details</p>
            </div>
            <div id="w-addr" hidden>
              <div class="grid2">
                <div class="f"><label>GSTIN</label><input type="text" id="w-v-gstin" class="ro" readonly></div>
                <div class="f"><label>PAN</label><input type="text" id="w-v-pan" class="ro" readonly></div>
              </div>
              <div class="grid1"><div class="f"><label class="req">Address line 1</label><input type="text" name="w_a1" data-rule="text" placeholder="Building, street"><div class="err"></div></div></div>
              <div class="grid1"><div class="f"><label>Address line 2</label><input type="text" name="w_a2" data-rule="any" data-opt placeholder="Area, landmark"></div></div>
              <div class="grid3">
                <div class="f"><label class="req">City</label><input type="text" name="w_city" data-rule="text" placeholder="Enter city"><div class="err"></div></div>
                <div class="f"><label>State</label><input type="text" id="w-v-state" class="ro" readonly></div>
                <div class="f"><label class="req">Pincode</label><input type="text" name="w_pin" data-rule="pin" inputmode="numeric" maxlength="6" placeholder="6 digit pincode"><div class="err"></div></div>
              </div>
            </div>
          </div>
        </div>
        <div class="sec">
          <div class="sec-l"><svg class="ck"><use href="#i-check"/></svg><div><h3>Warehouse Details</h3><p>Enter warehouse contact details, processing capacity and timings.</p></div></div>
          <div class="sec-r">
            <div class="grid2">
              <div class="f"><label class="req">Warehouse contact number</label><input type="text" name="w_phone" data-rule="phone" inputmode="numeric" maxlength="10" placeholder="Enter 10 digit contact number"><div class="err"></div></div>
              <div class="f"><label class="req">Warehouse email ID</label><input type="text" name="w_email" data-rule="email" placeholder="Enter email ID"><div class="err"></div></div>
            </div>
            <div class="grid2">
              <div class="f"><label class="req">Per day processing capacity</label><input type="text" name="w_cap" data-rule="int" inputmode="numeric" placeholder="Enter number of units"><div class="err"></div></div>
            </div>
            <div class="grid2">
              <div class="f"><label class="req">Warehouse start time</label><select name="w_start" data-rule="any"><option value="">Select start time</option></select><div class="err"></div></div>
              <div class="f"><label class="req">Warehouse end time</label><select name="w_end" data-rule="any"><option value="">Select end time</option></select><div class="err"></div></div>
            </div>
          </div>
        </div>
      </div>
      <div class="m-f"><button type="button" class="btn ghost" data-close>Cancel</button><button type="button" class="btn" data-act="save-wh" disabled>Add Warehouse</button></div>
    </div>
  </div>

  <!-- ============ MODAL : BRAND ============ -->
  <div class="modal" data-modal="br" hidden>
    <div class="m-card" role="dialog" aria-modal="true">
      <div class="m-h"><svg><use href="#i-tag"/></svg><h2 id="br-title">Brand 1 Details :</h2><button type="button" class="m-x" data-close aria-label="Close"><svg><use href="#i-x"/></svg></button></div>
      <div class="m-b">
        <div class="sec">
          <div class="sec-l"><svg class="ck"><use href="#i-check"/></svg><div><h3>Brand Name and Documents</h3><p>Please enter brand name and select a seller type and upload documents.</p><p class="info">Uploading <b>documents is not mandatory</b>, you can submit it till <b>30 days</b> after onboarding.</p></div></div>
          <div class="sec-r">
            <div class="f"><label class="req">Brand Name</label><input type="text" name="b_name" data-rule="text" maxlength="60" placeholder="Enter brand name"><div class="err"></div></div>
            <div class="f"><label class="req">Seller type</label>
              <div class="grid2 opts">
                <label class="opt"><input type="radio" name="b_type" value="Brand owner"> Brand owner</label>
                <label class="opt"><input type="radio" name="b_type" value="Authorised distributor / reseller"> Authorised distributor / reseller</label>
              </div></div>
            <div class="grid2">
              <div class="drop sm" data-key="brandLogo" tabindex="0">
                <input type="file" hidden accept="image/png,image/jpeg,image/webp">
                <div class="drop-empty"><span class="up"><svg><use href="#i-up"/></svg></span><p>+ Add Brand Logo</p></div>
                <div class="drop-file"><svg class="fi"><use href="#i-doc"/></svg><span class="drop-name"></span><button type="button" class="link" data-remove>Remove</button></div>
                <div class="drop-err"></div>
              </div>
              <div class="drop sm" data-key="brandDoc" tabindex="0">
                <input type="file" hidden accept="image/png,image/jpeg,application/pdf">
                <div class="drop-empty"><span class="up"><svg><use href="#i-up"/></svg></span><p>+ Add Brand document (trademark / authorisation)</p></div>
                <div class="drop-file"><svg class="fi"><use href="#i-doc"/></svg><span class="drop-name"></span><button type="button" class="link" data-remove>Remove</button></div>
                <div class="drop-err"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="sec">
          <div class="sec-l"><svg class="ck"><use href="#i-check"/></svg><div><h3>Categories You Sell</h3><p>Enter primary categories you sell and select corresponding secondary categories.</p></div></div>
          <div class="sec-r">
            <div class="f"><label class="req">Select Primary Category You Sell</label><select name="b_cat" data-rule="any"><option value="">Select Category</option></select><div class="err"></div></div>
            <div class="f" id="b-sec-wrap" hidden><label class="req">Select Secondary Categories</label><div class="tags" id="b-sec"></div><div class="msg-err" id="b-sec-err" hidden>Select at least one secondary category.</div></div>
          </div>
        </div>
        <div class="sec">
          <div class="sec-l"><svg class="ck"><use href="#i-check"/></svg><div><h3>Business and E-Commerce Details</h3><p>Enter number of SKUs sold, average selling price and other platforms you sell on.</p></div></div>
          <div class="sec-r">
            <div class="grid2">
              <div class="f"><label class="req">Total SKUs You Sell Under This Brand</label><input type="text" name="b_sku" data-rule="int" inputmode="numeric" placeholder="Enter no. of SKUs"><div class="err"></div></div>
              <div class="f"><label class="req">Average Selling Price (₹)</label><input type="text" name="b_asp" data-rule="num" inputmode="decimal" placeholder="Enter average selling price"><div class="err"></div></div>
            </div>
            <div class="f"><label class="req">Do you sell this brand on other e-commerce platforms?</label>
              <div class="grid2 opts">
                <label class="opt"><input type="radio" name="b_other" value="Yes"> Yes</label>
                <label class="opt"><input type="radio" name="b_other" value="No"> No</label>
              </div></div>
            <div class="f" id="b-plat-wrap" hidden><label class="req">Select platforms</label><div class="tags" id="b-plat"></div></div>
            <div class="f"><label>Brand website / store link</label><input type="text" name="b_web" data-rule="url" data-opt placeholder="https://"><div class="err"></div></div>
          </div>
        </div>
      </div>
      <div class="m-f"><button type="button" class="btn ghost" data-close>Cancel</button><button type="button" class="btn" data-act="save-br" disabled>Add Brand</button></div>
    </div>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</div>

<style>
.msp{--tx:#282c3f;--mu:#696e79;--bd:#d4d5d9;--er:#d0021b;--ok:#03a685;--acl:color-mix(in srgb,var(--ac) 9%,#fff);font-family:Roboto,"Segoe UI",Arial,sans-serif;color:var(--tx);font-size:14px;line-height:1.45;background:linear-gradient(160deg,#fff6ef 0%,#f1ecfa 45%,#e4dbfc 100%);padding:0 0 64px}
.msp *{box-sizing:border-box}
.msp svg{width:20px;height:20px;flex:none}
.msp button{font-family:inherit;cursor:pointer}
.msp-notice{background:#0b57c1;color:#fff;text-align:center;padding:10px 16px;font-size:13px;font-weight:500}
.msp-wrap{max-width:970px;margin:0 auto;padding:24px 14px 0}
.msp .card{background:#fff;border-radius:16px;box-shadow:0 2px 14px rgba(40,44,63,.08);margin-bottom:18px;padding:8px 32px}
/* tabs */
.msp .msp-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;padding:8px 10px}
.msp .tab{display:flex;align-items:center;justify-content:center;gap:8px;height:46px;border:1px solid #ececf1;background:#f8f8fa;border-radius:8px;font-size:14px;font-weight:500;color:var(--tx)}
.msp .tab svg{width:18px;height:18px}
.msp .tab.on{background:var(--ac);border-color:var(--ac);color:#fff}
.msp .tab.ok:not(.on){border-color:var(--ok);color:var(--ok)}
/* section rows */
.msp .sec{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.75fr);gap:32px;padding:26px 0;border-top:1px solid #e9e9ee}
.msp .card>.sec:first-child,.msp .m-b>.sec:first-child{border-top:0}
.msp .sec-l{display:flex;gap:14px}
