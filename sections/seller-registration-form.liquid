.msp .btn:disabled{background:#d4d5d9;border-color:#d4d5d9;color:#8a8d99;cursor:not-allowed}
.msp .btn .ar{width:14px;height:14px}.msp .btn .ar.l{transform:rotate(180deg)}
.msp .link{background:none;border:0;color:var(--ac);font-size:12px;text-decoration:underline;padding:0}
.msp .nav{display:flex;justify-content:space-between;align-items:center;padding:16px 24px}
