.msp .item dt{font-size:11px;color:var(--mu)}.msp .item dd{margin:2px 0 0;font-size:13px;word-break:break-word}
.msp .addcard{display:flex;flex-direction:column;align-items:center;gap:10px;width:100%;border:1px solid #b9a8f2;color:var(--ac);font-size:15px;font-weight:400;padding:28px}
.msp .addcard svg{width:36px;height:36px}
.msp .addcard:hover{background:var(--acl)}
.msp .tags{display:flex;flex-wrap:wrap;gap:8px}
.msp .tags label{display:flex;align-items:center;gap:6px;border:1px solid var(--bd);border-radius:16px;padding:6px 12px;font-size:12px;cursor:pointer}
.msp .tags label:has(input:checked){border-color:var(--ac);background:var(--acl);color:var(--ac)}
.msp .tags input{accent-color:var(--ac);margin:0}
.msp .gbox{background:#f8f8fa;border-radius:8px;padding:18px;display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;font-size:12px;color:#494d5b}
.msp .gbox p{margin:0}.msp .illu{width:140px;height:96px}
.msp .gbox.found{align-items:stretch;text-align:left}
.msp .gbox dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:0}
.msp .gbox dt{font-size:11px;color:var(--mu)}.msp .gbox dd{margin:2px 0 0;font-size:13px;color:var(--tx);font-weight:500}
/* modal */
.msp .modal{position:fixed;inset:0;z-index:9999;background:rgba(40,44,63,.62);display:flex;align-items:center;justify-content:center;padding:16px}
.msp .modal[hidden]{display:none}
.msp .m-card{background:#fff;border-radius:14px;width:min(1000px,100%);max-height:90vh;display:flex;flex-direction:column;box-shadow:0 18px 60px rgba(0,0,0,.3)}
.msp .m-card.small{width:min(560px,100%)}
.msp .m-h{display:flex;align-items:center;gap:10px;padding:20px 24px 12px}
.msp .m-h h2{margin:0;font-size:22px;font-weight:700;flex:1}
.msp .m-x{border:0;background:none;color:var(--tx);padding:4px}
.msp .m-b{padding:0 24px;overflow:auto;flex:1}
.msp .m-b>.sec{padding:22px 0}
.msp .m-card.small .m-b{padding-bottom:16px}
.msp .m-f{display:flex;justify-content:flex-end;gap:14px;padding:16px 24px;border-top:1px solid #e9e9ee}
/* done + toast */
.msp .done{text-align:center;padding:48px 24px}
.msp .done .big{width:64px;height:64px;color:var(--ok)}
.msp .done h2{margin:12px 0 6px;font-size:22px}
.msp .done p{margin:0 auto 6px;max-width:520px;color:#494d5b}
.msp .toast{position:fixed;left:50%;bottom:28px;transform:translate(-50%,20px);background:#282c3f;color:#fff;padding:12px 18px;border-radius:8px;font-size:13px;opacity:0;pointer-events:none;transition:.25s;z-index:10000;max-width:92vw}
.msp .toast.show{opacity:1;transform:translate(-50%,0)}
.msp [hidden]{display:none!important}
@media (max-width:760px){
  .msp .card{padding:6px 16px}
  .msp .msp-tabs{gap:6px;padding:6px}
  .msp .tab{font-size:11px;height:48px;flex-direction:column;gap:2px;padding:0 4px}
  .msp .sec{grid-template-columns:1fr;gap:16px;padding:20px 0}
  .msp .grid1,.msp .grid2,.msp .grid3{grid-template-columns:1fr}
  .msp .item dl{grid-template-columns:1fr 1fr}
  .msp .gbox dl{grid-template-columns:1fr}
  .msp .m-card{max-height:96vh}
  .msp .m-h h2{font-size:18px}
}
@media (prefers-reduced-motion:reduce){.msp .toast{transition:none}}
</style>

<script>
{% raw %}
(function () {
  document.querySelectorAll('.msp').forEach(init);

  function init(root) {
    const $ = (s, r) => (r || root).querySelector(s);
    const $$ = (s, r) => [...(r || root).querySelectorAll(s)];
    const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const cfg = { endpoint: (root.dataset.endpoint || '').trim(), maxMb: +root.dataset.maxmb || 2 };

    /* ---------- reference data ---------- */
    const STATES = { '01': 'Jammu & Kashmir', '02': 'Himachal Pradesh', '03': 'Punjab', '04': 'Chandigarh', '05': 'Uttarakhand', '06': 'Haryana', '07': 'Delhi', '08': 'Rajasthan', '09': 'Uttar Pradesh', '10': 'Bihar', '11': 'Sikkim', '12': 'Arunachal Pradesh', '13': 'Nagaland', '14': 'Manipur', '15': 'Mizoram', '16': 'Tripura', '17': 'Meghalaya', '18': 'Assam', '19': 'West Bengal', '20': 'Jharkhand', '21': 'Odisha', '22': 'Chhattisgarh', '23': 'Madhya Pradesh', '24': 'Gujarat', '26': 'Dadra & Nagar Haveli and Daman & Diu', '27': 'Maharashtra', '29': 'Karnataka', '30': 'Goa', '31': 'Lakshadweep', '32': 'Kerala', '33': 'Tamil Nadu', '34': 'Puducherry', '35': 'Andaman & Nicobar Islands', '36': 'Telangana', '37': 'Andhra Pradesh', '38': 'Ladakh', '97': 'Other Territory' };
    const BANKS = { SBIN: 'State Bank of India', HDFC: 'HDFC Bank', ICIC: 'ICICI Bank', UTIB: 'Axis Bank', PUNB: 'Punjab National Bank', BARB: 'Bank of Baroda', KKBK: 'Kotak Mahindra Bank', IDIB: 'Indian Bank', CNRB: 'Canara Bank', YESB: 'Yes Bank', UBIN: 'Union Bank of India', INDB: 'IndusInd Bank', BKID: 'Bank of India', IOBA: 'Indian Overseas Bank', FDRL: 'Federal Bank' };
    const PLATFORMS = ['Amazon', 'Flipkart', 'Meesho', 'Ajio', 'Nykaa', 'Own website', 'Other'];
    const CATS = {};
    (root.dataset.cats || '').split(/\r?\n|<br\s*\/?>/).forEach(l => {
      const i = l.indexOf(':'); if (i < 1) return;
      const k = l.slice(0, i).trim(), v = l.slice(i + 1).split(',').map(s => s.trim()).filter(Boolean);
      if (k && v.length) CATS[k] = v;
    });

    /* ---------- validation ---------- */
    function gstOk(g) {
      if (!/^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$/.test(g)) return false;
      const cs = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ'; let sum = 0;
      for (let i = 0; i < 14; i++) { const v = cs.indexOf(g[i]) * (i % 2 === 0 ? 1 : 2); sum += Math.floor(v / 36) + (v % 36); }
      return cs[(36 - (sum % 36)) % 36] === g[14];
    }
    function gstInfo(raw) {
      const g = String(raw || '').trim().toUpperCase();
      if (!gstOk(g) || !STATES[g.slice(0, 2)]) return null;
      return { gstin: g, pan: g.slice(2, 12), state: STATES[g.slice(0, 2)] };
    }
    const R = {
      name: v => /^[A-Za-z][A-Za-z .'-]{2,59}$/.test(v) || 'Enter a valid full name (letters only)',
      phone: v => /^[6-9]\d{9}$/.test(v) || 'Enter a valid 10 digit mobile number',
      email: v => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v) || 'Enter a valid email ID',
      gstin: v => (gstInfo(v) ? true : 'Enter a valid 15 character GSTIN'),
      tan: v => /^[A-Z]{4}[0-9]{5}[A-Z]$/.test(v) || 'Enter a valid TAN (e.g. ABCD12345E)',
      ifsc: v => /^[A-Z]{4}0[A-Z0-9]{6}$/.test(v) || 'Enter a valid 11 character IFSC code',
      acc: v => /^\d{9,18}$/.test(v) || 'Account number must be 9 to 18 digits',
      pin: v => /^[1-9]\d{5}$/.test(v) || 'Enter a valid 6 digit pincode',
      int: v => /^[1-9]\d{0,8}$/.test(v) || 'Enter a whole number greater than 0',
      num: v => (/^\d+(\.\d{1,2})?$/.test(v) && +v > 0) || 'Enter a valid amount greater than 0',
      text: v => v.length >= 2 || 'Enter at least 2 characters',
      url: v => /^(https?:\/\/)?([\w-]+\.)+[a-z]{2,}(\/\S*)?$/i.test(v) || 'Enter a valid link'
    };
    function msg(el) {
      if (el.closest('[hidden]')) return '';
      let v = (el.value || '').trim();
      if (el.dataset.upper) v = v.toUpperCase();
      if (!v) return el.hasAttribute('data-opt') ? '' : (el.tagName === 'SELECT' ? 'Please select an option' : 'This field is required');
      const f = R[el.dataset.rule]; if (!f) return '';
      const r = f(v); return r === true ? '' : r;
    }
    function setErr(el, m) {
      const f = el.closest('.f'); if (!f) return;
      f.classList.toggle('bad', !!m);
      const e = f.querySelector('.err'); if (e) e.textContent = m || '';
    }
    function quiet(scope) { return $$('[data-rule]', scope).every(el => !msg(el)); }
    function loud(scope) {
      let first = null;
      $$('[data-rule]', scope).forEach(el => { const m = msg(el); setErr(el, m); if (m && !first) first = el; });
      return first;
    }

    /* ---------- state ---------- */
    const S = { gst: [], wh: [], br: [], bankReq: false };
    const FILES = { signature: null, cheque: null, brandLogo: null, brandDoc: null };
    const M = { gst: null, wh: null, whEdit: -1, brEdit: -1 };
    let cur = 0;

    const val = n => { const e = $('[name="' + n + '"]'); return e ? e.value.trim() : ''; };
    const tdsVal = () => (($('input[name=tds]:checked') || {}).value) || '';

    function toast(t) {
      const el = $('#toast'); el.textContent = t; el.classList.add('show');
      clearTimeout(toast.t); toast.t = setTimeout(() => el.classList.remove('show'), 3200);
    }
    const fmtSize = b => b > 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b / 1024)) + ' KB';

    /* ---------- file drop zones ---------- */
    $$('.drop').forEach(d => {
      const key = d.dataset.key, input = $('input[type=file]', d);
      d.addEventListener('click', e => { if (e.target.closest('[data-remove]')) return; input.click(); });
      d.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); } });
      input.addEventListener('click', e => e.stopPropagation());
      input.addEventListener('change', () => { if (input.files[0]) takeFile(key, input.files[0]); input.value = ''; });
      ['dragenter', 'dragover'].forEach(ev => d.addEventListener(ev, e => { e.preventDefault(); d.classList.add('over'); }));
      ['dragleave', 'drop'].forEach(ev => d.addEventListener(ev, e => { e.preventDefault(); d.classList.remove('over'); }));
      d.addEventListener('drop', e => { const f = e.dataTransfer.files[0]; if (f) takeFile(key, f); });
      $('[data-remove]', d).addEventListener('click', e => { e.stopPropagation(); FILES[key] = null; drawDrop(key); refresh(); });
    });
    function drawDrop(key, err) {
      const d = $('.drop[data-key="' + key + '"]'), f = FILES[key];
      d.classList.toggle('has', !!f); d.classList.toggle('bad', !!err);
      $('.drop-name', d).textContent = f ? f.name + ' (' + fmtSize(f.size) + ')' : '';
      $('.drop-err', d).textContent = err || '';
    }
    function takeFile(key, file) {
      const d = $('.drop[data-key="' + key + '"]'), accept = $('input[type=file]', d).accept.split(',');
      const okType = accept.some(a => a.endsWith('/*') ? file.type.startsWith(a.slice(0, -1)) : a === file.type);
      if (!okType) return drawDrop(key, 'Unsupported file type. Upload ' + accept.map(a => a.split('/')[1]).join(' / ').toUpperCase());
      if (file.size > cfg.maxMb * 1048576) return drawDrop(key, 'File is too large. Maximum ' + cfg.maxMb + ' MB');
      const rd = new FileReader();
      rd.onload = () => { FILES[key] = { name: file.name, type: file.type, size: file.size, data: rd.result }; drawDrop(key); refresh(); };
      rd.onerror = () => drawDrop(key, 'Could not read the file. Try again');
      rd.readAsDataURL(file);
    }

    /* ---------- generic input handling ---------- */
    root.addEventListener('input', e => {
      const el = e.target;
      if (el.dataset && el.dataset.upper) { const p = el.selectionStart; el.value = el.value.toUpperCase().replace(/\s/g, ''); try { el.setSelectionRange(p, p); } catch (x) { } }
      if (['phone', 'pin', 'int', 'acc'].includes(el.dataset && el.dataset.rule) && el.name !== 'w_gstin') el.value = el.value.replace(/\D/g, '');
      if (el.matches && el.matches('[data-rule]') && el.closest('.f').classList.contains('bad')) setErr(el, msg(el));
      if (el.name === 'ifsc') { const b = BANKS[el.value.slice(0, 4)]; if (b && el.value.length >= 4 && !val('bank')) { $('[name=bank]').value = b; } }
      if (['pname', 'pphone', 'pemail'].includes(el.name) && $('#same-owner').checked) copyOwner();
      if (el.name === 'g_gstin') { M.gst = null; resetGstBox(); }
      if (el.name === 'w_gstin') { M.wh = null; $('#w-box').hidden = false; $('#w-addr').hidden = true; }
      if (['ifsc', 'acc', 'bank', 'holder'].includes(el.name) && S.bankReq) { S.bankReq = false; drawBankVerify(); }
      refresh();
    });
    root.addEventListener('change', e => {
      const el = e.target;
      if (el.name === 'tds') { $('#tan-wrap').hidden = el.value !== 'yes'; $('#tds-err').hidden = true; }
      if (el.id === 'same-owner') { toggleOwner(el.checked); }
      if (el.name === 'b_cat') drawSecondary();
      if (el.name === 'b_other') $('#b-plat-wrap').hidden = el.value !== 'Yes';
      if (el.matches('select[data-rule]')) setErr(el, msg(el));
      refresh();
    });
    root.addEventListener('focusout', e => { const el = e.target; if (el.matches && el.matches('[data-rule]') && el.tagName !== 'SELECT') setErr(el, msg(el)); });

    /* ---------- owner = primary ---------- */
    function copyOwner() {
      $('[name=oname]').value = val('pname'); $('[name=ophone]').value = val('pphone'); $('[name=oemail]').value = val('pemail');
      ['oname', 'ophone', 'oemail'].forEach(n => setErr($('[name=' + n + ']'), ''));
    }
    function toggleOwner(on) {
      ['oname', 'ophone', 'oemail'].forEach(n => { const e = $('[name=' + n + ']'); e.disabled = on; if (!on) e.value = ''; });
      if (on) copyOwner();
    }

    /* ---------- tabs / nav ---------- */
    function sellerReady() { return quiet($('[data-panel="0"]')) && S.gst.length > 0 && !!tdsVal() && !!FILES.signature && !!FILES.cheque && S.bankReq; }
    function validateSeller() {
      const p = $('[data-panel="0"]'); const first = loud(p); let target = first;
      $('#gst-err').hidden = S.gst.length > 0; if (!S.gst.length && !target) target = $('#gst-err');
      $('#tds-err').hidden = !!tdsVal(); if (!tdsVal() && !target) target = $('#tds-err');
      ['signature', 'cheque'].forEach(k => { if (!FILES[k]) { drawDrop(k, 'This file is required'); if (!target) target = $('.drop[data-key=' + k + ']'); } });
      $('#bank-err').hidden = S.bankReq; if (!S.bankReq && !target) target = $('#bank-err');
      if (target) { target.scrollIntoView({ behavior: 'smooth', block: 'center' }); if (target.focus) target.focus({ preventScroll: true }); toast('Please complete the highlighted details'); return false; }
      return true;
    }
    function goTab(n) {
      if (n > 0 && !sellerReady()) { if (cur === 0) validateSeller(); else n = 0; if (cur === 0) return; }
      if (n > 1 && !S.wh.length) { $('#wh-err').hidden = false; n = 1; if (cur === 1) { toast('Add at least one warehouse'); return; } }
      cur = n;
      $$('.tab').forEach((t, i) => t.classList.toggle('on', i === n));
      $$('.panel').forEach((p, i) => p.hidden = i !== n);
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      refresh();
    }
    $$('.tab').forEach(t => t.addEventListener('click', () => goTab(+t.dataset.tab)));

    /* ---------- GSTIN list + modal ---------- */
    function drawGst() {
      $('#gst-list').innerHTML = S.gst.map((g, i) => '<div class="chip"><b>' + esc(g.gstin) + '</b><span>PAN ' + esc(g.pan) + ' · ' + esc(g.state) + '</span><button type="button" class="link" data-act="del-gst" data-i="' + i + '">Remove</button></div>').join('');
      $('#gst-err').hidden = true;
      $('#wh-gst-list').innerHTML = S.gst.map(g => '<option value="' + esc(g.gstin) + '">').join('');
    }
    function resetGstBox() { const b = $('#g-box'); b.className = 'gbox'; b.innerHTML = '<p>Enter GST number to view details</p>'; }
    function openModal(name) {
      const m = $('[data-modal="' + name + '"]'); m.hidden = false; document.documentElement.style.overflow = 'hidden';
      const f = $('input:not([readonly]):not([type=hidden])', m); if (f) setTimeout(() => f.focus(), 30); refresh();
    }
    function closeModal(m) {
      m.hidden = true; document.documentElement.style.overflow = '';
      $$('.f.bad', m).forEach(f => f.classList.remove('bad'));
    }
    $$('.modal').forEach(m => {
      m.addEventListener('mousedown', e => { if (e.target === m) closeModal(m); });
      $$('[data-close]', m).forEach(b => b.addEventListener('click', () => closeModal(m)));
    });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') $$('.modal').forEach(m => { if (!m.hidden && root.contains(m)) closeModal(m); }); });

    function verifyGst(input, onOk) {
      const info = gstInfo(input.value);
      if (!info) { setErr(input, 'Enter a valid 15 character GSTIN'); return null; }
      setErr(input, ''); onOk(info); return info;
    }

    /* ---------- warehouse ---------- */
    const timeOpts = (() => { let h = ''; for (let i = 0; i < 48; i++) { const hh = Math.floor(i / 2), mm = i % 2 ? '30' : '00', ap = hh >= 12 ? 'PM' : 'AM', h12 = hh % 12 || 12; h += '<option value="' + String(hh).padStart(2, '0') + ':' + mm + '">' + h12 + ':' + mm + ' ' + ap + '</option>'; } return h; })();
    $('[name=w_start]').insertAdjacentHTML('beforeend', timeOpts);
    $('[name=w_end]').insertAdjacentHTML('beforeend', timeOpts);
    const t12 = v => { if (!v) return ''; const [h, m] = v.split(':'); const n = +h; return (n % 12 || 12) + ':' + m + ' ' + (n >= 12 ? 'PM' : 'AM'); };

    function whValid() { return !!M.wh && M.wh.gstin === val('w_gstin').toUpperCase() && quiet($('[data-modal=wh]')) && val('w_start') < val('w_end'); }
    function showWhAddr(info) {
      M.wh = info; $('#w-box').hidden = true; $('#w-addr').hidden = false;
      $('#w-v-gstin').value = info.gstin; $('#w-v-pan').value = info.pan; $('#w-v-state').value = info.state;
    }
    function openWh(i) {
      M.whEdit = i; const m = $('[data-modal=wh]');
      $$('input:not([readonly]),select', m).forEach(e => { if (e.type !== 'button') e.value = ''; });
      $('#w-box').hidden = false; $('#w-addr').hidden = true; M.wh = null;
      $('#wh-title').textContent = 'Warehouse ' + (i >= 0 ? i + 1 : S.wh.length + 1) + ' Details :';
      $('[data-act=save-wh]').textContent = i >= 0 ? 'Save Warehouse' : 'Add Warehouse';
      if (i >= 0) {
        const w = S.wh[i]; showWhAddr({ gstin: w.gstin, pan: w.pan, state: w.state });
        Object.entries({ w_gstin: w.gstin, w_a1: w.address1, w_a2: w.address2, w_city: w.city, w_pin: w.pincode, w_phone: w.phone, w_email: w.email, w_cap: w.capacity, w_start: w.startTime, w_end: w.endTime }).forEach(([k, v]) => $('[name=' + k + ']').value = v || '');
      }
      openModal('wh');
    }
    function drawWh() {
      $('#wh-list').innerHTML = S.wh.map((w, i) => '<div class="item"><div class="item-h"><svg><use href="#i-wh"/></svg><b>Warehouse ' + (i + 1) + '</b><div class="acts"><button type="button" class="link" data-act="edit-wh" data-i="' + i + '">Edit</button><button type="button" class="link" data-act="del-wh" data-i="' + i + '">Delete</button></div></div><dl>'
        + '<div><dt>GSTIN</dt><dd>' + esc(w.gstin) + '</dd></div>'
        + '<div style="grid-column:span 2"><dt>Address</dt><dd>' + esc([w.address1, w.address2, w.city, w.state, w.pincode].filter(Boolean).join(', ')) + '</dd></div>'
        + '<div><dt>Contact</dt><dd>' + esc(w.phone) + '</dd></div><div><dt>Email</dt><dd>' + esc(w.email) + '</dd></div><div><dt>Per day capacity</dt><dd>' + esc(w.capacity) + ' units</dd></div>'
        + '<div><dt>Timings</dt><dd>' + t12(w.startTime) + ' – ' + t12(w.endTime) + '</dd></div></dl></div>').join('');
      $('#wh-err').hidden = true;
    }

    /* ---------- brand ---------- */
    $('[name=b_cat]').insertAdjacentHTML('beforeend', Object.keys(CATS).map(k => '<option>' + esc(k) + '</option>').join(''));
    $('#b-plat').innerHTML = PLATFORMS.map(p => '<label><input type="checkbox" value="' + p + '"> ' + p + '</label>').join('');
    function drawSecondary(sel) {
      const c = val('b_cat'), w = $('#b-sec-wrap'); w.hidden = !c;
      $('#b-sec').innerHTML = (CATS[c] || []).map(s => '<label><input type="checkbox" value="' + esc(s) + '"' + (sel && sel.includes(s) ? ' checked' : '') + '> ' + esc(s) + '</label>').join('');
    }
    const checked = sel => $$(sel + ' input:checked').map(i => i.value);
    function brValid() {
      const m = $('[data-modal=br]');
      return quiet(m) && !!$('input[name=b_type]:checked') && checked('#b-sec').length > 0 && !!$('input[name=b_other]:checked') && ($('input[name=b_other]:checked').value === 'No' || checked('#b-plat').length > 0);
    }
    function openBr(i) {
      M.brEdit = i; const m = $('[data-modal=br]');
      $$('input[type=text],select', m).forEach(e => e.value = '');
      $$('input[type=radio],input[type=checkbox]', m).forEach(e => e.checked = false);
      FILES.brandLogo = FILES.brandDoc = null; drawDrop('brandLogo'); drawDrop('brandDoc');
      $('#b-sec-wrap').hidden = true; $('#b-plat-wrap').hidden = true;
      $('#br-title').textContent = 'Brand ' + (i >= 0 ? i + 1 : S.br.length + 1) + ' Details :';
      $('[data-act=save-br]').textContent = i >= 0 ? 'Save Brand' : 'Add Brand';
      if (i >= 0) {
        const b = S.br[i];
        Object.entries({ b_name: b.name, b_cat: b.primaryCategory, b_sku: b.totalSkus, b_asp: b.avgSellingPrice, b_web: b.website }).forEach(([k, v]) => $('[name=' + k + ']').value = v || '');
        const t = $('input[name=b_type][value="' + b.sellerType + '"]'); if (t) t.checked = true;
        drawSecondary(b.secondaryCategories);
        const o = $('input[name=b_other][value="' + b.sellsElsewhere + '"]'); if (o) o.checked = true;
        $('#b-plat-wrap').hidden = b.sellsElsewhere !== 'Yes';
        $$('#b-plat input').forEach(c => c.checked = (b.platforms || []).includes(c.value));
        FILES.brandLogo = b.logo; FILES.brandDoc = b.document; drawDrop('brandLogo'); drawDrop('brandDoc');
      }
      openModal('br');
    }
    function drawBr() {
      $('#br-list').innerHTML = S.br.map((b, i) => '<div class="item"><div class="item-h"><svg><use href="#i-tag"/></svg><b>' + esc(b.name) + '</b><div class="acts"><button type="button" class="link" data-act="edit-br" data-i="' + i + '">Edit</button><button type="button" class="link" data-act="del-br" data-i="' + i + '">Delete</button></div></div><dl>'
        + '<div><dt>Seller type</dt><dd>' + esc(b.sellerType) + '</dd></div><div><dt>Primary category</dt><dd>' + esc(b.primaryCategory) + '</dd></div><div><dt>Secondary categories</dt><dd>' + esc(b.secondaryCategories.join(', ')) + '</dd></div>'
        + '<div><dt>Total SKUs</dt><dd>' + esc(b.totalSkus) + '</dd></div><div><dt>Avg. selling price</dt><dd>₹' + esc(b.avgSellingPrice) + '</dd></div><div><dt>Other platforms</dt><dd>' + esc(b.sellsElsewhere === 'Yes' ? b.platforms.join(', ') : 'No') + '</dd></div></dl></div>').join('');
      $('#br-err').hidden = true;
    }

    /* ---------- bank verification ---------- */
    function bankFieldsOk() { return ['bank', 'ifsc', 'acc', 'holder'].every(n => !msg($('[name=' + n + ']'))); }
    function drawBankVerify() {
      const b = $('#bank-verify'); b.textContent = S.bankReq ? 'Verification requested' : 'Send Amount To Verify Account';
      $('#bank-note').hidden = !S.bankReq;
    }

    /* ---------- refresh (checks / disabled states) ---------- */
    function refresh() {
      const secs = {
        gst: () => S.gst.length > 0,
        primary: () => quiet($('#sec-primary')),
        owner: () => quiet($('#sec-owner')),
        tds: () => tdsVal() === 'no' || (tdsVal() === 'yes' && !msg($('[name=tan]'))),
        sign: () => !!FILES.signature,
        bank: () => !!FILES.cheque && bankFieldsOk(),
        bverify: () => S.bankReq
      };
      $$('.panel[data-panel="0"] .sec').forEach(s => s.classList.toggle('done', !!(secs[s.dataset.sec] && secs[s.dataset.sec]())));
      $('#bank-verify').disabled = !(bankFieldsOk() && FILES.cheque) || S.bankReq;
      const gi = $('[name=g_gstin]'); $('[data-act=verify-gst]').disabled = gi.value.length !== 15;
      $('[data-act=save-gst]').disabled = !(M.gst && M.gst.gstin === gi.value.toUpperCase());
      $('[data-act=verify-wh]').disabled = val('w_gstin').length !== 15;
      $('[data-act=save-wh]').disabled = !whValid();
      $('[data-act=save-br]').disabled = !brValid();
      $('#submit-btn').disabled = !S.br.length;
      const ok0 = sellerReady(), ok1 = S.wh.length > 0, ok2 = S.br.length > 0;
      $$('.tab').forEach((t, i) => t.classList.toggle('ok', [ok0, ok1, ok2][i] && !t.classList.contains('on')));
    }

    /* ---------- click actions ---------- */
    root.addEventListener('click', e => {
      const b = e.target.closest('[data-act]'); if (!b) return;
      const act = b.dataset.act, i = +b.dataset.i;
      switch (act) {
        case 'open-gst': $('[name=g_gstin]').value = ''; M.gst = null; resetGstBox(); setErr($('[name=g_gstin]'), ''); openModal('gst'); break;
        case 'verify-gst': verifyGst($('[name=g_gstin]'), info => {
          M.gst = info; const bx = $('#g-box'); bx.className = 'gbox found';
          bx.innerHTML = '<dl><div><dt>GSTIN</dt><dd>' + esc(info.gstin) + '</dd></div><div><dt>PAN</dt><dd>' + esc(info.pan) + '</dd></div><div><dt>State</dt><dd>' + esc(info.state) + '</dd></div></dl>';
        }); refresh(); break;
        case 'save-gst':
          if (S.gst.some(g => g.gstin === M.gst.gstin)) { setErr($('[name=g_gstin]'), 'This GSTIN is already added'); break; }
          S.gst.push(M.gst); drawGst(); closeModal($('[data-modal=gst]')); refresh(); break;
        case 'del-gst': S.gst.splice(i, 1); drawGst(); refresh(); break;
        case 'open-wh': openWh(-1); break;
        case 'edit-wh': openWh(i); break;
        case 'del-wh': if (confirm('Delete this warehouse?')) { S.wh.splice(i, 1); drawWh(); refresh(); } break;
        case 'verify-wh': verifyGst($('[name=w_gstin]'), showWhAddr); refresh(); break;
        case 'save-wh': {
          if (!whValid()) { loud($('[data-modal=wh]')); break; }
          const w = { gstin: M.wh.gstin, pan: M.wh.pan, state: M.wh.state, address1: val('w_a1'), address2: val('w_a2'), city: val('w_city'), pincode: val('w_pin'), phone: val('w_phone'), email: val('w_email'), capacity: val('w_cap'), startTime: val('w_start'), endTime: val('w_end') };
          if (M.whEdit >= 0) S.wh[M.whEdit] = w; else S.wh.push(w);
          drawWh(); closeModal($('[data-modal=wh]')); refresh(); break;
        }
        case 'open-br': openBr(-1); break;
        case 'edit-br': openBr(i); break;
        case 'del-br': if (confirm('Delete this brand?')) { S.br.splice(i, 1); drawBr(); refresh(); } break;
        case 'save-br': {
          if (!brValid()) { loud($('[data-modal=br]')); break; }
          const br = { name: val('b_name'), sellerType: $('input[name=b_type]:checked').value, logo: FILES.brandLogo, document: FILES.brandDoc, primaryCategory: val('b_cat'), secondaryCategories: checked('#b-sec'), totalSkus: val('b_sku'), avgSellingPrice: val('b_asp'), sellsElsewhere: $('input[name=b_other]:checked').value, platforms: $('input[name=b_other]:checked').value === 'Yes' ? checked('#b-plat') : [], website: val('b_web') };
          if (M.brEdit >= 0) S.br[M.brEdit] = br; else S.br.push(br);
          FILES.brandLogo = FILES.brandDoc = null; drawBr(); closeModal($('[data-modal=br]')); refresh(); break;
        }
        case 'next': goTab(cur + 1); break;
        case 'prev': goTab(cur - 1); break;
        case 'submit': submit(b); break;
      }
    });
    $('#bank-verify').addEventListener('click', () => {
      /* Real penny-drop needs a payment API (Razorpay / Cashfree). Hook it here; for now the request is recorded. */
      if (!bankFieldsOk()) return;
      S.bankReq = true; $('#bank-err').hidden = true; drawBankVerify(); refresh();
    });

    /* ---------- submit to Google Sheet ---------- */
    async function submit(btn) {
      if (!sellerReady()) { goTab(0); validateSeller(); return; }
      if (!S.wh.length) { goTab(1); return; }
      if (!S.br.length) { $('#br-err').hidden = false; return; }
      const id = 'SLR-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 5).toUpperCase();
      const payload = {
        submissionId: id, submittedAt: new Date().toISOString(), pageUrl: location.href,
        seller: {
          gstins: S.gst,
          primaryContact: { name: val('pname'), phone: val('pphone'), email: val('pemail') },
          owner: { sameAsPrimary: $('#same-owner').checked, name: val('oname'), phone: val('ophone'), email: val('oemail') },
          tds: { claim: tdsVal(), tan: tdsVal() === 'yes' ? val('tan').toUpperCase() : '' },
          signature: FILES.signature,
          bank: { cheque: FILES.cheque, bankName: val('bank'), accountType: 'Current Account', ifsc: val('ifsc').toUpperCase(), accountNumber: val('acc'), holderName: val('holder'), verification: S.bankReq ? 'Requested' : 'Pending' }
        },
        warehouses: S.wh, brands: S.br
      };
      if (!cfg.endpoint) { console.log('Payload (no endpoint set):', payload); toast('Google Sheet link is not set. Add the Apps Script URL in the section settings.'); return; }
      const old = btn.innerHTML; btn.disabled = true; btn.textContent = 'Submitting…';
      try {
        const res = await fetch(cfg.endpoint, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(payload, (k, v) => (k === 'data' && typeof v === 'string' && v.startsWith('data:')) ? undefined : v) });
        const j = await res.json();
        if (!j.ok) throw new Error(j.error || 'Server error');
        $$('.panel').forEach(p => p.hidden = true); $('.msp-tabs').hidden = true;
        $('#done-title').textContent = root.dataset.successTitle || 'Registration submitted';
        $('#done-text').textContent = root.dataset.successText || '';
        $('#done-id').textContent = id; $('#done').hidden = false; root.scrollIntoView({ behavior: 'smooth' });
      } catch (err) {
        console.error(err); toast('Could not submit right now. Check your internet and try again.');
        btn.innerHTML = old; btn.disabled = false;
      }
    }

    drawGst(); drawWh(); drawBr(); refresh();
  }
})();
{% endraw %}
</script>

{% schema %}
{
  "name": "Seller Registration Form",
  "tag": "section",
  "class": "msp-section",
  "settings": [
    { "type": "header", "content": "Google Sheet" },
    { "type": "text", "id": "endpoint", "label": "Google Apps Script Web App URL", "info": "Paste the /exec URL after deploying google-apps-script.gs (no Drive folder needed)" },
    { "type": "range", "id": "max_file_mb", "label": "Max upload size per file (MB)", "min": 1, "max": 5, "step": 1, "default": 2 },
    { "type": "header", "content": "Look" },
    { "type": "color", "id": "accent", "label": "Accent colour", "default": "#5333d6" },
    { "type": "text", "id": "notice", "label": "Top notice bar text", "info": "Leave empty to hide" },
    { "type": "header", "content": "Brand categories" },
    { "type": "textarea", "id": "categories", "label": "Categories", "info": "One per line. Format: Primary: Secondary 1, Secondary 2", "default": "Men's Fashion: T-Shirts, Shirts, Jeans, Trousers, Ethnic Wear, Innerwear, Footwear\nWomen's Fashion: Kurtas & Suits, Sarees, Dresses, Tops, Jeans, Lingerie, Footwear\nKids: Boys Clothing, Girls Clothing, Infants, Footwear, Toys\nHome & Living: Bedding, Furniture, Decor, Kitchen & Dining, Storage\nBeauty & Personal Care: Skincare, Makeup, Haircare, Fragrances, Grooming\nAccessories: Bags, Watches, Jewellery, Sunglasses, Belts & Wallets\nElectronics & Gadgets: Audio, Wearables, Mobile Accessories, Smart Home" },
    { "type": "header", "content": "After submit" },
    { "type": "text", "id": "success_title", "label": "Success title", "default": "Registration submitted" },
    { "type": "textarea", "id": "success_text", "label": "Success message", "default": "Thank you. Your seller details have been received. Our team will review them and contact you on your registered phone number and email." }
  ],
  "presets": [{ "name": "Seller Registration Form" }]
}
{% endschema %}
