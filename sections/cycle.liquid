{% for block in section.blocks %}
    {% cycle '<div class="wrapper">', '', '' %}
    <div class="{% cycle 'class-1', 'class-2' %}" {{ forloop.index }}>Text {{ block.settings.text }}</div>
    {% cycle '','', '</div>' %}
{% endfor %}

{% schema %}
{
  "name": "Cycle",
  "settings": [],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.multirow.blocks.row.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },        
      ]
    }
  ],
  "presets": [
    { "name": "Cycle" }
  ]
}
{% endschema %}