<section class="seller-protection-section">
  <div class="seller-protection-bg"></div>

  <!-- Decorative Images -->
  {% if section.settings.top_image != blank %}
    <div class="floating-image floating-image-top">
      {{
        section.settings.top_image
        | image_url: width: 400
        | image_tag: loading: 'lazy'
      }}
    </div>
  {% endif %}

  {% if section.settings.bottom_image != blank %}
    <div class="floating-image floating-image-bottom">
      {{
        section.settings.bottom_image
        | image_url: width: 400
        | image_tag: loading: 'lazy'
      }}
    </div>
  {% endif %}

  <div class="page-width">
    <div class="seller-content">

      {% if section.settings.logo != blank %}
        <div class="seller-logo">
          {{
            section.settings.logo
            | image_url: width: 200
            | image_tag: loading: 'lazy'
          }}
        </div>
      {% endif %}

      <div class="title-row">
        <h2>{{ section.settings.heading }}</h2>

        <div class="important-badge">
          <span>IMPORTANT</span>
        </div>
      </div>

      <div class="seller-points">

        <div class="point-item">
          <div class="point-icon">
            ⚠
          </div>
          <div class="point-text">
            <strong>Beware of individuals posing as representatives.</strong>
            We do not charge any onboarding fee or refundable deposit.
          </div>
        </div>

        <div class="point-item">
          <div class="point-icon">
            👜
          </div>
          <div class="point-text">
            <strong>A one-time growth enablement charge applies</strong>
            once you begin selling. It is adjusted against your payouts and
            provides equivalent ad credits.
          </div>
        </div>

        <div class="point-item">
          <div class="point-icon">
            👤
          </div>
          <div class="point-text">
            <strong>Fraudulent activity may result in civil and criminal action.</strong>
            We will cooperate with law enforcement but are not liable for losses
            caused by imposters.
          </div>
        </div>

        <div class="point-item">
          <div class="point-icon">
            🚀
          </div>
          <div class="point-text">
            <strong>An optional assisted ads program is included at no extra cost.</strong>
            See the Commercial Terms Agreement for details.
          </div>
        </div>

      </div>

      <a href="{{ section.settings.button_link }}" class="seller-btn">
        {{ section.settings.button_text }}
      </a>

    </div>
  </div>
</section>

<style>
.seller-protection-section{
  position:relative;
  overflow:hidden;
  padding:60px 0 80px;
  background:#fff;
}

.seller-protection-bg{
  position:absolute;
  inset:0;
  background:
    radial-gradient(circle at center,
      rgba(214,198,255,.55) 0%,
      rgba(255,236,245,.45) 35%,
      rgba(255,255,255,0) 70%);
  z-index:0;
}

.seller-protection-section .page-width{
  position:relative;
  z-index:2;
  max-width:1400px;
  margin:0 auto;
  padding:0 40px;
}

.seller-content{
  max-width:760px;
}

.seller-logo{
  margin-bottom:40px;
}

.seller-logo img{
  max-width:110px;
  height:auto;
}

.title-row{
  display:flex;
  align-items:center;
  gap:25px;
  margin-bottom:50px;
}

.title-row h2{
  margin:0;
  font-size:52px;
  line-height:1.15;
  font-weight:700;
  color:#202020;
}

.important-badge{
  width:90px;
  height:90px;
  border:2px solid #8d8d8d;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  transform:rotate(-15deg);
  flex-shrink:0;
}

.important-badge span{
  font-size:13px;
  letter-spacing:1px;
  font-weight:700;
  color:#666;
}

.seller-points{
  display:flex;
  flex-direction:column;
  gap:42px;
  margin-bottom:50px;
}

.point-item{
  display:flex;
  align-items:flex-start;
  gap:20px;
}

.point-icon{
  width:42px;
  height:42px;
  min-width:42px;
  border:1.5px solid #6f92ff;
  color:#6f92ff;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:18px;
}

.point-text{
  font-size:18px;
  line-height:1.8;
  color:#222;
}

.point-text strong{
  font-weight:700;
}

.seller-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-width:670px;
  height:58px;
  padding:0 40px;
  background:#5145cd;
  color:#fff;
  text-decoration:none;
  border-radius:14px;
  font-weight:600;
  transition:.3s ease;
}

.seller-btn:hover{
  background:#4437c6;
}

.floating-image{
  position:absolute;
  z-index:1;
}

.floating-image img{
  display:block;
  width:100%;
  height:auto;
}

.floating-image-top{
  right:70px;
  top:20px;
  width:220px;
  transform:rotate(10deg);
}

.floating-image-bottom{
  right:20px;
  bottom:80px;
  width:240px;
  transform:rotate(12deg);
}

@media (max-width: 991px){

  .title-row{
    flex-direction:column;
    align-items:flex-start;
  }

  .title-row h2{
    font-size:38px;
  }

  .seller-btn{
    min-width:100%;
  }

  .floating-image{
    opacity:.15;
  }
}

@media (max-width: 767px){

  .seller-protection-section{
    padding:40px 0 60px;
  }

  .page-width{
    padding:0 20px;
  }

  .title-row h2{
    font-size:30px;
  }

  .point-text{
    font-size:15px;
    line-height:1.7;
  }

  .floating-image{
    display:none;
  }
}
</style>

{% schema %}
{
  "name": "Seller Protection",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Protecting Our Seller Community"
    },
    {
      "type": "image_picker",
      "id": "top_image",
      "label": "Top Right Image"
    },
    {
      "type": "image_picker",
      "id": "bottom_image",
      "label": "Bottom Right Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Continue And Start Selling"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Seller Protection"
    }
  ]
}
{% endschema %}


