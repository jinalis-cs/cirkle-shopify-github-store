<section class="partner-login-form" aria-label="Partner login form">
  <div class="partner-login-form__inner">
    <div>
      <h1 class="partner-login-form__headline">Partner login</h1>
      <p class="partner-login-form__subtext">Sign in to access your partner dashboard and manage your Myntra seller experience.</p>

      {%- form 'customer_login', novalidate: 'novalidate' -%}
        {% if form.errors %}
          <div class="partner-login-form__error">
            <p style="color:#dc2626; font-weight:700; margin-bottom:1rem;">{{ 'templates.customer.login.errors' | t }}</p>
          </div>
        {% endif %}

        <label class="partner-login-form__label" for="CustomerEmail">{{ 'customer.login_page.email' | t }}</label>
        <input class="partner-login-form__input" type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="Email address" required>

        <label class="partner-login-form__label" for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label>
        <input class="partner-login-form__input" type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" placeholder="Password" required>

        <div class="partner-login-form__actions">
          <button type="submit" class="partner-login-form__submit">Sign In</button>
          <a class="partner-login-form__link" href="{{ routes.account_recover_password_url }}">Forgot password?</a>
        </div>

        <p class="partner-login-form__note">Don’t have an account? <a class="partner-login-form__link" href="{{ routes.account_register_url }}">Create one</a></p>
      {%- endform -%}
    </div>

    <aside class="partner-login-form__aside">
      <div class="partner-login-form__aside-card">
        <p class="partner-login-form__aside-title">Partner benefits</p>
        <p class="partner-login-form__aside-copy">Manage orders, track performance, and access special Myntra partner tools from your secure dashboard.</p>
        <a class="partner-login-form__aside-cta" href="#">Learn more</a>
      </div>
      <div class="partner-login-form__aside-card">
        <p class="partner-login-form__aside-title">Need help?</p>
        <p class="partner-login-form__aside-copy">If you have trouble signing in, our partner support team is available to help.</p>
        <a class="partner-login-form__aside-cta" href="#">Contact support</a>
      </div>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Login form",
  "settings": [],
  "presets": [
    {
      "name": "Partner login form"
    }
  ]
}
{% endschema %} {% endcomment %}
