{% if section.blocks.size > 0 %}
    <style>
        a.alphabetic-link {
            color: #000;
            text-decoration: none;
            padding: 0 5px;
            font-size: 19px;
        }
        a.alphabetic-link.disabled {
            pointer-events: none;
            color: #808080;
        }
        .brand-letter-content {
            display: flex;
            gap: 20px;
            padding: 10px 0;
        }
    </style>
    {% assign alphabetic = "abcdefhijkmnopqrstuvwxyz" | split: ''  %}
    {% comment %} {% capture brand_letter_content %}{% endcapture %}
    {% capture alphabetic_content %}{% endcapture %}
    {% for letter in alphabetic %}       
        {% capture brand_list %}
           {% for block in section.blocks %}
                {% if block.settings.brand_name and block.settings.brand_logo %}
                    {% assign brand_letter = block.settings.brand_name | slice: 0 | downcase %}
                    {% if brand_letter == letter %}
                        <div class="brand-item" id="{{ brand_letter }}" data-brand="{{ block.settings.brand_name | escape }}" data-letter="{{ brand_letter }}">
                            <a href="{{ block.settings.brand_url | default: '#' }}" target="_blank">
                                <img src="{{ block.settings.brand_logo | img_url: 'medium' }}" alt="{{ block.settings.brand_name }}">
                                {% comment %} <h3>{{ block.settings.brand_name }}</h3> {% endcomment %}
                            </a>
                        </div>
                    {% endif %}
                {% endif %}
            {% endfor %}
        {% endcapture %} 
        {% capture brand_letter_content %}
          {{ brand_letter_content }}
          {% if brand_list != blank %}
          <div class="brand-letter" data-letter="{{ letter }}">   
                <div class="brand-letter-title">{{ letter | upcase }}</div>
                <div class="brand-letter-content">
                    {{ brand_list }}
                </div>                        
            </div>
            {% endif %}
        {% endcapture %}
        {% capture alphabetic_content %}
            {{ alphabetic_content }}
            <a href="#{{ letter }}" class="alphabetic-link{% unless brand_list != blank %} disabled{% endunless %}" data-letter="{{ letter }}">{{ letter | upcase }}</a>
        {% endcapture %}
    {% endfor %} {% endcomment %}
    <div class="brand-details">
        <div class="page-width brand-warp">
            <div class="alphabetic-list">
                {% for letter in alphabetic %}
                    {% assign has_brand = false %}
                    {% for block in section.blocks %}
                        {% assign first = block.settings.brand_name | slice: 0 | downcase %}
                        {% if first == letter %}
                            {% assign has_brand = true %}
                            {% break %}
                        {% endif %}
                    {% endfor %}
                    <a href="#{{ letter }}"class="alphabetic-link{% unless has_brand %} disabled{% endunless %}">{{ letter | upcase }}</a>
                {% endfor %}
            </div>
            <div class="brand-list">
                {% for letter in alphabetic %}
                    {% assign has_brand = false %}
                    {% for block in section.blocks %}
                        {% assign first = block.settings.brand_name | slice: 0 | downcase %}
                        {% if first == letter %}
                            {% assign has_brand = true %}
                            {% break %}
                        {% endif %}
                    {% endfor %}
                    {% if has_brand %}
                        <div class="brand-letter" data-letter="{{ letter }}">   
                            <div class="brand-letter-title">{{ letter | upcase }}</div>
                            <div class="brand-letter-content">
                                {% for block in section.blocks %}
                                    {% if block.settings.brand_name and block.settings.brand_logo %}
                                        {% assign brand_letter = block.settings.brand_name | slice: 0 | downcase %}
                                        {% if brand_letter == letter %}
                                            <div class="brand-item" id="{{ brand_letter }}" data-brand="{{ block.settings.brand_name | escape }}" data-letter="{{ brand_letter }}">
                                                <a href="{{ block.settings.brand_url | default: '#' }}" target="_blank">
                                                    <img src="{{ block.settings.brand_logo | img_url: 'medium' }}" alt="{{ block.settings.brand_name }}">
                                                    {% comment %} <h3>{{ block.settings.brand_name }}</h3> {% endcomment %}
                                                </a>
                                            </div>
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                            </div>                        
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
{% endif %}   


{% schema %}
{
  "name": "Brand",
  "settings": [],
  "blocks": [
    {
      "type": "Brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "brand_logo",
          "label": "Brand Logo"
        },
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand Name"
        },
        {
            "type": "url",
            "id": "brand_url",
            "label": "Brand URL"
        }
      ]
    }
  ],
  "presets": [
    { 
        "name": "Brand",
        "category": "Custom section"
    }
  ]
}
{% endschema %}