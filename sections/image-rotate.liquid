<style>


.section-custom-image-block{overflow:hidden;}
.section-custom-image-block .image-blocks-wrapper {display: flex;gap: 100px;align-items: center;margin: auto;}
.section-custom-image-block .image-blocks-wrapper.image-left{flex-direction: row;}
.section-custom-image-block .image-blocks-wrapper.image-right{flex-direction: row-reverse;}
.section-custom-image-block .image-wrapper {flex: 1; width: 100%;}
.section-custom-image-block .blocks-wrapper {flex: 1;}
.section-custom-image-block .blocks-wrapper .h2{font-size:50px;line-height:70px; text-transform:capitalize;}
.section-custom-image-block .blocks-wrapper ul{list-style:none;padding:0; display:flex;flex-direction:column;gap:15px;}
.section-custom-image-block .blocks-wrapper ul li{padding-left: 27px; position:relative;}
.section-custom-image-block .blocks-wrapper ul li:before{ height: 15px;width: 15px;content:""; position:absolute; left:0; top:4px; background-size:15px; background: url(https://cdn.shopify.com/s/files/1/1038/4244/7692/files/list-icon.svg?v=1773143499);}

.section-custom-image-block .content {margin: 20px 0 40px 0; color:#333333;}
.section-custom-image-block .button-wrapper-main{display:flex; align-items:center; gap:10px;}
.section-custom-image-block .media{overflow:visible;}
.section-custom-image-block .caption {
    color: #629550;
    font-size: 16px;
    font-weight: 700;
    text-transform: capitalize;
    line-height: 65px;
    margin-bottom: 0px;
}

.section-custom-image-block .page-width{position:relative;}
.section-custom-image-block .pop-video{position:fixed; top:50%; left:50%; transform:translate(-50%, -50%);}


/* parent handles rotation */
.parallax-rotate {
  transform: rotate(65deg) scale(0.85);
  opacity: 0;
  transition: transform 2s cubic-bezier(0.22, 1, 0.36, 1),
              opacity 1.2s ease;
}

/* final state */
.parallax-rotate.wake-up {
  transform: rotate(0deg) scale(1);
  opacity: 1;
  transition: transform 2s cubic-bezier(0.22, 1, 0.36, 1),
              opacity 1.2s ease;
}

/* keep your parallax clean */
.parallax-img {
  transition: transform 0.1s linear;
  will-change: transform;
}


@media(max-width : 1199px){
    .section-custom-image-block .blocks-wrapper .h2{font-size:40px;line-height:50px;}
}

@media(max-width : 989px){
    .section-custom-image-block .image-blocks-wrapper{gap:40px;}
    .section-custom-image-block .image-blocks-wrapper.image-left {flex-direction:column;}
    .section-custom-image-block .image-blocks-wrapper.image-right{flex-direction:column;}
    .section-custom-image-block .image-blocks-wrapper.image-bottom{flex-direction:column-reverse; align-items:start;}
    .section-custom-image-block .image-wrapper{max-width:500px;}

}


@media(max-width : 749px){
    .section-custom-image-block .image-blocks-wrapper{gap:60px;}
    .section-custom-image-block .content {margin: 10px 0 20px 0;}
    .section-custom-image-block .blocks-wrapper{width:100%; text-align:center;}
    .section-custom-image-block .blocks-wrapper .h2{font-size:30px;line-height:40px;}
    .section-custom-image-block .caption { line-height: 25px; }
    .section-custom-image-block .button-wrapper-main{justify-content:center;margin-top: 30px;}
    .section-custom-image-block .image-wrapper {max-width: 287px;margin-left: auto;}


    
}
</style>

