{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<link
  rel="preload"
  href="{{ 'component-rte.css' | asset_url }}"
  as="style"
  onload="this.onload=null;this.rel='stylesheet'">
  {% assign page = pages[section.settings.pagr_val] %}
  {% comment %} {% if page.metafields.custom.product_variants.value != blank %} {% endcomment %}
    <div class="product-grid-container product--main--container" id="main_category_top">
      <div class="category-product-list">
        {% for product in collections['all'].products %}
          {% assign show_product = true %}
          {% if product.tags contains 'hide-from-mayple' and localization.country.iso_code != 'US' %}
            {% assign show_product = false %}
          {% endif %}
          
          {% if show_product %}
            {% for variant in product.variants %}            
              <div class="list-products" >
                {{  product.title }}
              </div>
            {% endfor %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% comment %} {% endif %} {% endcomment %}
  
{% schema %}
  {
    "name": "Home Color Coordinated",    
    "settings": [
      {
        "type": "page",
        "id": "pagr_val",
        "label": "Select Page"
      }
    ],
    "presets": [{"name": "Home Color Coordinated"}]
  }
{% endschema %}