{% schema %}
{
  "name": "Luxe Hero Banner",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "desk_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mob_image",
      "label": "Mobile Image"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Pre Heading"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": " Sub Heading"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Label"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "sub_heading",
          "label": "Pre Heading"
        },
        {
          "type": "richtext",
          "id": "heading",
          "label": " Sub Heading"
        },
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "desk_image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mob_image",
          "label": "Mobile Image"
        },    
        {
          "type": "header",
          "content": "Video"
        },    
        {
          "type": "video",
          "id": "video",
          "label": "Desktop Video"
        },
        {
          "type": "video",
          "id": "mob_video",
          "label": "Mobile Video"
        },
        {
          "type": "image_picker",
          "id": "cover_image",
