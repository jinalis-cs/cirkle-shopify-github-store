        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Link"
        }
      ]
    }
  ],  
  "presets": [
    {
      "name": "Luxe Hero Banner",
      "category": "Luxe"
    }
  ]
}
{% endschema %}
