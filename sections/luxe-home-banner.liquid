
{% style %}
    .banner-image .aspect-ratio {
    padding-top: min(832px, 72%);
    height: 100%;
  }

  .banner-image .aspect-ratio img {
    object-fit: cover;
  }

  .hero-banner-outer {
    display: grid;
  }

  .hero-banner-outer .banner-image,
  .hero-banner-outer .banner-content {
    grid-area: 1/1;
  }

  .hero-banner-outer .banner-content {
    padding-top: calc(var(--header-height) + clamp(2rem, 3.906vw - 1rem, 4rem));
    padding-bottom: clamp(2rem, 3.906vw - 1rem, 4rem);
    position: relative;
    display: grid;
    color: var(--white);
  }

  .hero-banner-outer .sub-heading {
    font: var(--text-lg);
    font-weight: 500;
  }

  .hero-banner-outer .sub-heading+.heading {
    margin-top: 5px;
  }

  .hero-banner-outer .heading {
    font-weight: 400;
  }

  .hero-banner-outer .banner-content .content-wpr {
    /* max-width: clamp(44rem, 37.109vw + 15.5rem, 63rem); */
    width: 100%;
  }

  .hero-banner-outer .banner-content .btn-wpr {
    margin-top: clamp(2rem, 3.906vw - 1rem, 4rem);
  }

  @media screen and (max-width:767px) {
    .banner-image .aspect-ratio {
      padding-top: max(600px, 90%);
      height: 100%;
    }
  }
{% endstyle %}

{% comment %} <section class="hero-banner-section" data-section="hero-banner" {{ section.shopify_attributes }}> 
  <div class="hero-banner-outer">
    {% for block in section.blocks %}
      
        <div class="banner-image" {{ block.shopify_attributes }}>
          <div class="aspect-ratio">
            {% if block.settings.desk_image != blank %}
              {%- assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840' -%}
              {%- assign image_height = block.settings.desk_image.width
                | divided_by: block.settings.desk_image.aspect_ratio
              -%}
              {{
                block.settings.desk_image
                | image_url: width: 3840
                | image_tag:
                  width: block.settings.desk_image.width,
                  height: image_height,
                  widths: widths,
                  class: 'desk-only',
                  fetchpriority: 'high'
              }}
            {% else %}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}

            {% if block.settings.mob_image != blank %}
              {%- assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840' -%}
              {%- assign image_height = block.settings.mob_image.width
                | divided_by: block.settings.mob_image.aspect_ratio
              -%}
              {{
                block.settings.mob_image
                | image_url: width: 3840
                | image_tag:
                  width: block.settings.mob_image.width,
                  height: image_height,
                  widths: widths,
                  class: 'mob-only',
                  fetchpriority: 'high'
              }}
            {% else %}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
        </div>
        {% if block.settings.sub_heading != blank
          or block.settings.heading != blank
          or block.settings.btn_label != blank
        %}
          <div class=" container  banner-content align--center align--middle mob:align--middle mob:align--center text-center md:text-center">
            <div class="content-wpr">
              {% if block.settings.sub_heading != blank %}
                <h4 class="sub-heading">{{ block.settings.sub_heading }}</h4>
              {% endif %}
              {% if block.settings.heading != blank %}
                <h1 class="heading">
                  {{ block.settings.heading }}
                </h1>
              {% endif %}
              {% if block.settings.btn_label != blank %}
                <div class="btn-wpr">
                  <a
                    {% if block.settings.btn_link != blank %}
                      href="{{ block.settings.btn_link }}"
                    {% endif %}
                    class="btn btn-secondary"
                  >
                    {{- block.settings.btn_label }}
                  </a>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      
    {% endfor %}    
  </div>
</section> {% endcomment %}

