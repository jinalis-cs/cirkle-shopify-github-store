      "label": "Sub Text"
    },
    {
      "type": "image_picker",
      "id": "desk_banner_image",
      "label": "Desktop banner Image"
    },
    {
      "type": "image_picker",
      "id": "mob_banner_image",
      "label": "Mobile banner Image"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "collection_list",
          "id": "collection_list",
          "label": "Collection list"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dotd category section"
    }
  ]
}
{% endschema %}
