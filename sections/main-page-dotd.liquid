{% if section.settings.desk_banner_image != blank or section.settings.mob_banner_image != blank %}
  {% style %}
    .doto_hero_inner{
      {% if section.settings.desk_banner_image != blank %}
        --desktop-bg: url({{ section.settings.desk_banner_image | image_url: width: section.settings.desk_banner_image.width }});
      {% endif %}
      {% if section.settings.mob_banner_image != blank %}
        --mobile-bg: url({{ section.settings.mob_banner_image | image_url: width: section.settings.mob_banner_image.width }});
      {% endif %}
    }
  {% endstyle %}
{% endif %}
{% if section.settings.text != blank
  or section.settings.sub_text != blank
  or section.settings.desk_banner_image != blank
  or section.settings.mob_banner_image != blank
%}
  <div class="doto_hero_section">
    <div class="doto_container">
      <div class="doto_hero_inner">
        {% if section.settings.text != blank or section.settings.sub_text != blank %}
          <div class="doto_hero_info">
            {% if section.settings.text != blank %}
              <h1>{{ section.settings.text }}</h1>
            {% endif %}
            {% if section.settings.sub_text != blank %}
              <p>{{ section.settings.sub_text }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{% if section.blocks.size > 0 %}
