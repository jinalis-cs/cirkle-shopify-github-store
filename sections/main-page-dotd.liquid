              {% if block.settings.image != blank %}
                <div class="doto_category_img">
                  {%- assign widths = '120, 220, 320, 420, 520, 700' -%}
                  {{
                    block.settings.image
                    | image_url: width: 320
                    | image_tag: widths: widths, loading: 'lazy', alt: block.settings.image.alt
                  }}
                </div>
              {% endif %}
              {% if block.settings.heading != blank %}
                <div class="doto_category_info">
                  <h5>{{ block.settings.heading | handleize }}</h5>
